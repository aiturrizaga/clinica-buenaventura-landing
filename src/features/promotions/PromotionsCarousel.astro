---
import { getPromotions } from './data';
import 'swiper/css';
import 'swiper/css/pagination';

const promotions = await getPromotions();
---

<section class="py-10 bg-white" aria-labelledby="promos-title">
    <div class="container">

        <div class="flex items-center justify-between mb-5">
            <h2
                    id="promos-title"
                    class="text-lg font-bold tracking-widest uppercase text-primary! m-0"
            >
                Novedades y Promociones
            </h2>

            <a href="/promociones" class="btn btn-ghost btn-sm">
                Ver todas →
            </a>
        </div>

        <div class="swiper promos-swiper">
            <div class="swiper-wrapper">
                {
                    promotions.map((promo) => (
                            <div class="swiper-slide">
                                <a href={ `/promociones/${ promo.slug }` }
                                   class="promo-card block overflow-hidden rounded-3xl shadow-sm"
                                >
                                    <div class="relative aspect-video">

                                        <img
                                                src={ promo.image }
                                                alt={ promo.title }
                                                loading="lazy"
                                                decoding="async"
                                                class="w-full h-full object-cover"
                                        />

                                        <div class="promo-overlay"></div>

                                    </div>
                                </a>
                            </div>
                    ))
                }
            </div>

            <div class="swiper-pagination"></div>
        </div>

    </div>
</section>

<style>
    .promos-swiper {
        padding-bottom: 2.5rem !important;
    }

    .promo-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        transition: transform .25s ease;
    }

    .promo-card:hover {
        transform: translateY(-4px);
    }

    .promo-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
                to top,
                rgba(0, 0, 0, .30) 0%,
                rgba(0, 0, 0, .08) 40%,
                transparent 100%
        );
    }

    .swiper-pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
    }

    .swiper-pagination-bullet {
        width: 8px !important;
        height: 8px !important;
        background: #d1d5db !important;
        opacity: 1 !important;
        border-radius: 9999px !important;
        transition: all .25s ease;
    }

    .swiper-pagination-bullet-active {
        width: 28px !important;
        background: var(--color-primary) !important;
    }
</style>

<script>
    import Swiper from 'swiper';
    import { Pagination, Autoplay } from 'swiper/modules';

    // astro:page-load dispara en la carga inicial y en cada navegación del
    // Client Router; el módulo del script no se re-ejecuta solo, así que sin
    // esto el carrusel deja de inicializarse al volver a esta página.
    // Se clona el contenedor antes de inicializar: garantiza que ni el
    // contenedor ni ninguno de sus nodos internos (los <a> de cada slide)
    // conserven listeners de una instancia anterior — sea por Swiper mismo,
    // por Astro (prefetch, etc.) o por cualquier otra cosa — que puedan
    // interferir con el drag/los dots o dejar un click "fantasma" pendiente
    // sobre el link de la slide.
    function initPromosSwiper() {
        const original = document.querySelector<HTMLElement>('.promos-swiper');
        if (!original) return;
        const el = original.cloneNode(true) as HTMLElement;
        original.replaceWith(el);

        const instance = new Swiper(el, {
            modules: [Pagination, Autoplay],
            spaceBetween: 12,
            loop: true,
            autoplay: {
                delay: 5000,
                disableOnInteraction: false,
            },
            pagination: {
                el: '.swiper-pagination',
                clickable: true,
            },
            breakpoints: {
                640: {
                    slidesPerView: 2,
                    spaceBetween: 16,
                },
            },
        });

        document.addEventListener('astro:before-swap', () => instance.destroy(true, true), { once: true });
    }

    document.addEventListener('astro:page-load', initPromosSwiper);
</script>
