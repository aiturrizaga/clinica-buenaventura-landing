---
import { getImage } from 'astro:assets';
import mobileSrc from '@assets/hero/fondo_principal-mobile.webp';
import tabletSrc from '@assets/hero/fondo_principal-tablet.webp';
import desktopSrc from '@assets/hero/fondo_principal-desktop.webp';
import wideSrc from '@assets/hero/fondo_principal-wide.webp';

// Picture con arte-dirección (una imagen distinta por breakpoint, no solo
// tamaños): astro:assets no tiene un componente para este caso, así que se
// optimiza cada fuente con getImage() y se arma el <picture> a mano.
const [mobile, tablet, desktop, wide] = await Promise.all(
    [mobileSrc, tabletSrc, desktopSrc, wideSrc].map((src) => getImage({ src })),
);
---
<section class="hero" aria-label="Sección principal">
    <div class="hero-bg-img" aria-hidden="true">
        <picture>
            <source
                    media="(max-width: 639px)"
                    srcset={mobile.src}
            />
            <source
                    media="(max-width: 1023px)"
                    srcset={tablet.src}
            />
            <source
                    media="(max-width: 1439px)"
                    srcset={desktop.src}
            />
            <source
                    media="(min-width: 1440px)"
                    srcset={wide.src}
            />
            <img
                    src={desktop.src}
                    alt=""
                    fetchpriority="high"
            />
        </picture>
    </div>
</section>

<style>
    /* Container */
    .hero {
        position: relative;
        height: clamp(420px, 50vw, 560px);
        display: flex;
        align-items: stretch;
        overflow: hidden;
        background-color: #ffffff;
    }

    @media (max-width: 639px) {
        .hero {
            height: auto;
            aspect-ratio: 4/5;
            min-height: unset;
            padding-block: 0;
            align-items: stretch;
        }
    }

    .hero-bg-img {
        position: absolute;
        inset: 0;
    }

    .hero-bg-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 20%;
        display: block;
    }

    @media (min-width: 1440px) {
        .hero {
            height: auto;
            width: 100%;
        }

        .hero-bg-img {
            position: relative;
            inset: unset;
            width: 100%;
        }

        .hero-bg-img picture {
            display: block;
            width: 100%;
        }

        .hero-bg-img img {
            object-fit: unset;
            width: 100%;
            height: auto;
            display: block;
        }
    }

    /* Mobile */
    @media (max-width: 639px) {
        .hero {
            height: auto;
            min-height: 480px;
            padding-block: 3rem 2.5rem;
        }
    }
</style>
