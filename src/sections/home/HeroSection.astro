<style>
    /* ── Contenedor ──────────────────────────────── */
    .hero {
        position: relative;
        height: clamp(420px, 50vw, 560px); /* máx 560px en desktop */
        display: flex;
        align-items: stretch;
        overflow: hidden;
    }

    @media (max-width: 639px) {
        .hero {
            height: auto;
            aspect-ratio: 4/5; /* respeta proporciones de la imagen mobile */
            min-height: unset;
            padding-block: 0;
            align-items: stretch;
        }
    }

    /* ── Imagen full-bleed ───────────────────────── */
    .hero-bg-img {
        position: absolute;
        inset: 0;
    }

    .hero-bg-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 20%;
        display: block;
    }

    /* Overlay: blanco/azul a la izquierda → transparente -->
    /* En mobile cubre más para legibilidad */
    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
                to right,
                rgba(238, 243, 255, 0.88) 0%,
                rgba(238, 243, 255, 0.75) 28%,
                rgba(238, 243, 255, 0.30) 52%,
                rgba(238, 243, 255, 0.05) 68%,
                transparent 100%
        );
    }

    @media (max-width: 639px) {
        .hero-overlay {
            background: linear-gradient(
                    to bottom,
                    rgba(238, 243, 255, 0.72) 0%,
                    rgba(238, 243, 255, 0.55) 55%,
                    rgba(238, 243, 255, 0.20) 100%
            );
        }
    }

    /* ── Texto encima ────────────────────────────── */
    .hero-content {
        position: relative;
        z-index: 1;
        width: 100%;
        display: flex;
        align-items: flex-end;
        padding-bottom: 1.5rem;
    }

    .hero-text {
        max-width: 500px;
    }

    @media (max-width: 639px) {
        .hero-text {
            max-width: 100%;
        }
    }

    /* Label chip */
    .hero-label {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-primary);
        background: rgba(10, 75, 255, 0.1);
        padding: 0.3rem 0.875rem;
        border-radius: var(--radius-full);
        margin-bottom: 0.875rem;
    }

    /* H1 */
    .hero-h1 {
        font-size: clamp(1.625rem, 3.5vw, 2.75rem);
        font-weight: 800;
        line-height: 1.1;
        color: var(--color-text);
        margin: 0 0 0.875rem;
    }

    .hero-h1-accent {
        color: var(--color-primary);
    }

    /* Subtítulo */
    .hero-sub {
        font-size: clamp(0.875rem, 1.5vw, 1rem);
        color: var(--color-text-muted);
        line-height: 1.65;
        margin: 0 0 1.5rem;
        max-width: 400px;
    }

    @media (max-width: 639px) {
        .hero-sub {
            max-width: 100%;
        }
    }

    /* CTAs */
    .hero-ctas {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-bottom: 0;
    }

    /* Botón outline sobre imagen */
    .btn-hero-outline {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-weight: 600;
        border-radius: var(--radius-md);
        transition: all 0.2s ease;
        cursor: pointer;
        border: 2px solid var(--color-primary);
        color: var(--color-primary);
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(4px);
        padding: 0.75rem 1.5rem;
        font-size: 0.9375rem;
    }

    .btn-hero-outline:hover {
        background: var(--color-primary);
        color: #fff;
    }

    /* Stats en fila compacta */
    .hero-stats {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .stat {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
    }

    .stat-value {
        font-size: 1.375rem;
        font-weight: 800;
        color: var(--color-primary);
        line-height: 1;
    }

    .stat-label {
        font-size: 0.75rem;
        color: var(--color-text-muted);
        font-weight: 500;
    }

    /* ── Mobile ──────────────────────────────────── */
    @media (max-width: 639px) {
        .hero {
            height: auto;
            min-height: 480px;
            padding-block: 3rem 2.5rem;
            align-items: flex-end; /* texto pegado abajo en mobile */
        }

        .hero-h1 {
            font-size: clamp(1.625rem, 7vw, 2.25rem);
        }

        .hero-stats {
            gap: 1.25rem;
        }

        .stat-value {
            font-size: 1.25rem;
        }
    }
</style>
