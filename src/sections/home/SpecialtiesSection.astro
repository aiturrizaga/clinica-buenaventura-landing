---
import SectionTitle from '../../components/ui/SectionTitle.astro';
import SpecialtyCard from '../../components/cards/SpecialtyCard.astro';
import { getFeaturedSpecialties } from '@data/specialties.ts';

const specs = getFeaturedSpecialties();
---

<section class="pb-16 md:pb-24 md:pt-4 bg-white" aria-labelledby="specs-title">
    <div class="container">

        <div class="mb-10 reveal">
            <SectionTitle
                    label="Especialidades"
                    title="Atención especializada para cada necesidad"
                    subtitle="Más de 30 especialidades con los mejores profesionales del país."
            />
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-3 reveal">
            { specs.map(s =>
                    <SpecialtyCard specialty={ s }/>) }

            <!-- Tile ver todas -->
            <a
                    href="/especialidades"
                    class="flex flex-col items-center justify-center text-center gap-3 p-5 bg-primary rounded-2xl hover:-translate-y-1 hover:shadow-lg transition-all duration-300 no-underline min-h-[160px]"
                    aria-label="Ver todas las especialidades"
            >
                <div class="grid grid-cols-2 gap-1.5">
                    { Array.from({ length: 4 }).map(() => (
                            <div class="w-3 h-3 bg-white/40 rounded-sm"></div>
                    )) }
                </div>
                <strong class="text-white text-sm leading-snug">
                    Ver todas →
                </strong>
            </a>
        </div>

        <!-- Botón mobile -->
        <div class="mt-6 text-center md:hidden">
            <a href="/especialidades" class="btn btn-outline btn-md">Ver todas las especialidades →</a>
        </div>

    </div>
</section>
