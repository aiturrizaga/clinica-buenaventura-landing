---
import SectionTitle from '../../components/ui/SectionTitle.astro';
import SpecialtyCard from '@features/specialties/SpecialtyCard.astro';
import { getFeaturedSpecialties } from '@features/specialties/data';

const specs = await getFeaturedSpecialties();
---

<section id="especialidades" class="pb-16 md:pb-24 md:pt-4 bg-white" aria-labelledby="specs-title">
    <div class="container">

        <div class="mb-10 reveal">
            <SectionTitle
                    id="specs-title"
                    label="Especialidades"
                    title="Atención especializada para cada necesidad"
                    subtitle="Más de 20 especialidades con los mejores profesionales del país."
            />
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-3 reveal">
            { specs.map(s =>
                    <SpecialtyCard specialty={ s }/>) }

            <!-- Tile ver todas -->
            <a
                    href="/especialidades"
                    class="hidden md:flex flex-col items-center justify-center text-center gap-3 p-5 bg-primary rounded-2xl hover:-translate-y-1 hover:shadow-lg transition-all duration-300 no-underline"
                    aria-label="Ver todas"
            >
                <div class="text-gray-200 flex items-center justify-center shrink-0">
                    <i class="ti ti-category"
                       style="font-size: 36px;"
                       aria-hidden="true"
                    ></i>
                </div>

                <h3 class="text-white! text-sm leading-snug">
                    Ver todas →
                </h3>

            </a>
        </div>

        <!-- Botón mobile -->
        <div class="mt-6 text-center md:hidden">
            <a href="/especialidades" class="btn btn-outline btn-md">Ver todas las especialidades →</a>
        </div>

    </div>
</section>
