---
import PageLayout from '../layouts/PageLayout.astro';
import HeroSection from '../sections/home/HeroSection.astro';
import PromotionsSection from '../sections/home/PromotionsSection.astro';
import SpecialtiesSection from '../sections/home/SpecialtiesSection.astro';
import AboutSection from '../sections/home/AboutSection.astro';
import ClubSection from '../sections/home/ClubSection.astro';
import DoctorsSection from '../sections/home/DoctorsSection.astro';
import TestimonialsSection from '../sections/home/TestimonialsSection.astro';
import { buildClinicSchema } from '../utils/seo';
---
<PageLayout
  title="Clínica Buenaventura | Excelencia Médica en Lima"
  description="Clínica médica en Lima con más de 30 especialidades. Atención de excelencia, tecnología avanzada y urgencias 24 horas. Agenda tu cita online."
  ogImage="/images/og-default.jpg"
  jsonLd={buildClinicSchema()}
>
  <HeroSection />
  <PromotionsSection />
  <SpecialtiesSection />
  <AboutSection />
  <ClubSection />

  <!-- Operating Room -->
  <section class="section-py or-section" aria-labelledby="or-title">
    <div class="container">
      <div class="or-grid">
        <div class="or-img reveal">
          <img
            src="https://images.unsplash.com/photo-1631217073612-131e4cebed99?w=640&h=480&fit=crop&auto=format"
            alt="Sala de operaciones Clínica Buenaventura"
            loading="lazy"
            width="640"
            height="480"
          />
        </div>
        <div class="or-text reveal" style="animation-delay:0.15s">
          <span class="or-label">Sala de operaciones</span>
          <h2 id="or-title" class="or-title">Tecnología y seguridad para tu tranquilidad</h2>
          <p class="or-desc">
            Contamos con salas de operaciones equipadas con tecnología de última generación
            y altos estándares de bioseguridad para garantizar los mejores resultados.
          </p>
          <ul class="or-list">
            {[
              'Equipos de última generación',
              'Personal altamente capacitado',
              'Protocolos de seguridad estrictos',
              'Ambiente controlado y esterilizado',
            ].map(item => (
              <li>
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="#0A4BFF" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>
          <a href="/servicios" class="btn btn-primary btn-md" style="margin-top:1.75rem">Conoce más</a>
        </div>
      </div>
    </div>
  </section>

  <DoctorsSection />
  <TestimonialsSection />
</PageLayout>

<style>
  .or-section { background: #fff; }
  .or-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }
  @media (min-width: 1024px) { .or-grid { grid-template-columns: 1fr 1fr; } }

  .or-img {
    border-radius: var(--radius-2xl);
    overflow: hidden;
    aspect-ratio: 4/3;
    box-shadow: 0 24px 48px rgba(0,0,0,0.1);
  }
  .or-img img { width:100%; height:100%; object-fit:cover; }

  .or-label {
    display: inline-block;
    font-size: 0.75rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-primary);
    background: var(--color-primary-50);
    padding: 0.375rem 1rem;
    border-radius: var(--radius-full);
    margin-bottom: 1rem;
  }
  .or-title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 800; line-height: 1.15;
    color: var(--color-text);
    margin: 0 0 1rem;
  }
  .or-desc {
    font-size: 1rem; color: var(--color-text-muted);
    line-height: 1.7; margin: 0;
  }
  .or-list {
    list-style: none; padding: 0;
    margin: 1.5rem 0 0;
    display: flex; flex-direction: column; gap: 0.75rem;
  }
  .or-list li {
    display: flex; align-items: center; gap: 0.75rem;
    font-size: 0.9375rem; color: var(--color-text);
    font-weight: 500;
  }
</style>
