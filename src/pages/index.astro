---
import PageLayout from '../layouts/PageLayout.astro';
import HeroSection from '../sections/home/HeroSection.astro';
import PromotionsCarousel from '@features/promotions/PromotionsCarousel.astro';
import SpecialtiesSection from '../sections/home/SpecialtiesSection.astro';
import AboutSection from '../sections/home/AboutSection.astro';
import DoctorsSection from '../sections/home/DoctorsSection.astro';
import { buildClinicSchema } from '@lib/seo';
import PromoPopup from '@features/promotions/PromoPopup.astro';
import promoTestAliento from '@assets/promotions/promo_test_de_aliento.webp';
---
<PageLayout
        title="Clínica Buenaventura | Comprometidos con tu confianza"
        noTitleSuffix
        description="Atención médica cercana y confiable para ti y tu familia. Más de 20 especialidades, cirugías, ecografías, rayos X, odontología, laboratorio y farmacia en San Juan de Miraflores, Lima Sur. Agenda tu cita online."
        jsonLd={ buildClinicSchema() }
>
    <PromoPopup
            image={ promoTestAliento }
            alt="Sorteo especial Día del Padre"
            waMessage="Hola Clínica Buenaventura, ¿Me pueden dar más información sobre el sorteo especial del Día del Padre?"
    />

    <HeroSection/>
    <PromotionsCarousel/>
    <SpecialtiesSection/>
    <AboutSection/>
    <DoctorsSection/>
</PageLayout>
