---
import PageLayout from '../layouts/PageLayout.astro';

const plans = [
  {
    name: 'Básico',
    price: 'S/ 29',
    period: '/mes',
    color: '#6B7280',
    benefits: [
      '10% dcto. en consultas',
      '15% dcto. en laboratorio',
      'Control de salud anual gratuito',
      'Acceso a telemedicina básica',
    ],
    cta: 'Afiliarme ahora',
  },
  {
    name: 'Premium',
    price: 'S/ 59',
    period: '/mes',
    color: '#0A4BFF',
    featured: true,
    benefits: [
      '20% dcto. en consultas',
      '30% dcto. en laboratorio',
      '25% dcto. en imágenes',
      '15% dcto. en farmacia',
      'Acceso a telemedicina ilimitada',
      'Prioridad en citas',
      'Sorteos exclusivos mensuales',
    ],
    cta: 'Ser Premium',
  },
  {
    name: 'Familiar',
    price: 'S/ 99',
    period: '/mes',
    color: '#059669',
    benefits: [
      'Todo lo de Premium',
      'Hasta 4 beneficiarios',
      'Pediatría con 30% dcto.',
      'Control dental anual',
      'Prioridad máxima en urgencias',
      'Beneficios de cumpleaños',
    ],
    cta: 'Afiliar mi familia',
  },
];

const faqs = [
  { q: '¿Cómo me afilio al Club?', a: 'Puedes afiliarte presencialmente en cualquiera de nuestras sedes o completando el formulario en línea. El proceso toma menos de 10 minutos.' },
  { q: '¿Los descuentos son acumulables?', a: 'Los descuentos del Club no son acumulables con otras promociones vigentes. Se aplica el descuento mayor en cada caso.' },
  { q: '¿Puedo incluir a mi familia?', a: 'Con el plan Familiar puedes incluir hasta 4 beneficiarios adicionales (cónyuge e hijos menores de 18 años).' },
  { q: '¿Hay periodo mínimo de permanencia?', a: 'No existe periodo mínimo. Puedes cancelar tu membresía en cualquier momento sin penalidades.' },
];
---
<PageLayout
  title="Club Buenaventura | Beneficios Exclusivos"
  description="Únete al Club Buenaventura y disfruta de descuentos en consultas, laboratorio, farmacia y beneficios exclusivos para ti y tu familia."
>
  <!-- Hero -->
  <section class="club-hero">
    <div class="container">
      <div class="club-hero-inner">
        <div class="reveal">
          <span class="hero-label">Membresía exclusiva</span>
          <h1 class="club-hero-h1">
            CLUB<br /><span style="color:#fff">BUENAVENTURA</span>
          </h1>
          <p class="club-hero-sub">
            Únete a nuestro programa de beneficios y disfruta de descuentos,
            acceso prioritario y mucho más para cuidar la salud de tu familia.
          </p>
          <a href="#planes" class="btn btn-white btn-lg">Ver planes y precios</a>
        </div>
        <div class="club-hero-image reveal" style="animation-delay:0.15s">
          <img
            src="https://images.unsplash.com/photo-1576091160550-2173dba999ef?w=600&h=480&fit=crop&auto=format"
            alt="Familia saludable Club Buenaventura"
            loading="eager"
            width="600"
            height="480"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section style="background:#fff;padding-block:3rem">
    <div class="container">
      <div class="club-stats">
        {[
          { n: '+8,000', l: 'Miembros activos' },
          { n: '30%', l: 'Máximo descuento' },
          { n: '4', l: 'Planes disponibles' },
          { n: '0', l: 'Costo de afiliación' },
        ].map(s => (
          <div class="cstat reveal">
            <span class="cstat-n">{s.n}</span>
            <span class="cstat-l">{s.l}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="section-py" style="background:var(--color-surface)">
    <div class="container">
      <div style="text-align:center;margin-bottom:3rem" class="reveal">
        <span class="section-label">¿Por qué unirse?</span>
        <h2 class="section-h2">Beneficios que marcan la diferencia</h2>
      </div>
      <div class="benefits-list">
        {[
          { icon:'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01', title:'Descuentos en laboratorio', desc:'Hasta 30% en análisis clínicos seleccionados' },
          { icon:'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z', title:'Descuentos en imágenes', desc:'25% en ecografías, rayos X y resonancias' },
          { icon:'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z', title:'Descuentos en farmacia', desc:'20% en medicamentos de nuestra farmacia' },
          { icon:'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z', title:'Prioridad en citas', desc:'Acceso preferencial sin largas esperas' },
          { icon:'M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7', title:'Sorteos exclusivos', desc:'Participa mensualmente en sorteos de regalos' },
          { icon:'M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z', title:'Beneficio de cumpleaños', desc:'Descuento especial el mes de tu cumpleaños' },
        ].map((b,i) => (
          <div class="benefit-block card reveal" style={`animation-delay:${i*0.08}s`}>
            <div class="bb-icon">
              <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={b.icon}/>
              </svg>
            </div>
            <h3>{b.title}</h3>
            <p>{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Planes -->
  <section class="section-py" style="background:#fff" id="planes">
    <div class="container">
      <div style="text-align:center;margin-bottom:3rem" class="reveal">
        <span class="section-label">Planes</span>
        <h2 class="section-h2">Elige el plan que mejor te convenga</h2>
      </div>
      <div class="plans-grid">
        {plans.map((plan, i) => (
          <div
            class:list={['plan-card card reveal', plan.featured && 'featured']}
            style={`animation-delay:${i*0.1}s;${plan.featured ? '--plan-color:'+plan.color : ''}`}
          >
            {plan.featured && <div class="plan-badge">Más popular</div>}
            <div class="plan-header" style={`background:${plan.color}`}>
              <h3 class="plan-name">{plan.name}</h3>
              <div class="plan-price">
                <span class="plan-amt">{plan.price}</span>
                <span class="plan-period">{plan.period}</span>
              </div>
            </div>
            <div class="plan-body">
              <ul class="plan-list">
                {plan.benefits.map(b => (
                  <li>
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke={plan.color} stroke-width="2.5" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                    {b}
                  </li>
                ))}
              </ul>
              <a
                href="/contacto"
                class="btn btn-lg"
                style={`width:100%;justify-content:center;background:${plan.color};color:#fff;box-shadow:none;border-color:${plan.color};margin-top:1.5rem`}
              >
                {plan.cta}
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-py" style="background:var(--color-surface)">
    <div class="container">
      <div style="text-align:center;margin-bottom:2.5rem" class="reveal">
        <span class="section-label">Preguntas frecuentes</span>
        <h2 class="section-h2">¿Tienes dudas?</h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq, i) => (
          <details class="faq-item card reveal" style={`animation-delay:${i*0.08}s`}>
            <summary class="faq-q">
              {faq.q}
              <svg class="faq-arrow" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <p class="faq-a">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .club-hero {
    background:linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
    padding-block:5rem 4rem;
    overflow:hidden;
  }
  .club-hero-inner {
    display:grid;grid-template-columns:1fr;gap:3rem;align-items:center;
  }
  @media (min-width:1024px) { .club-hero-inner { grid-template-columns:1fr 1fr; } }
  .hero-label {
    display:inline-block;font-size:0.75rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;
    color:rgba(255,255,255,0.75);background:rgba(255,255,255,0.15);
    padding:0.375rem 1rem;border-radius:var(--radius-full);margin-bottom:1.25rem;
  }
  .club-hero-h1 {
    font-size:clamp(2.5rem,5vw,4rem);font-weight:900;line-height:1;
    color:rgba(255,255,255,0.3);margin:0 0 1.25rem;
  }
  .club-hero-sub {
    font-size:1.0625rem;color:rgba(255,255,255,0.75);line-height:1.7;margin:0 0 2rem;max-width:440px;
  }
  .club-hero-image { border-radius:var(--radius-2xl);overflow:hidden;box-shadow:0 32px 64px rgba(0,0,0,0.25);aspect-ratio:5/4; }
  .club-hero-image img { width:100%;height:100%;object-fit:cover; }

  .club-stats { display:grid;grid-template-columns:repeat(2,1fr);gap:2rem; }
  @media (min-width:768px) { .club-stats { grid-template-columns:repeat(4,1fr); } }
  .cstat { text-align:center; }
  .cstat-n { display:block;font-size:2.5rem;font-weight:800;color:var(--color-primary);line-height:1; }
  .cstat-l { display:block;font-size:0.875rem;color:var(--color-text-muted);margin-top:0.375rem; }

  .section-label { display:inline-block;font-size:0.75rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-primary);margin-bottom:0.75rem; }
  .section-h2 { font-size:clamp(1.75rem,3vw,2.5rem);margin:0; }

  .benefits-list {
    display:grid;grid-template-columns:1fr;gap:1.25rem;
  }
  @media (min-width:640px) { .benefits-list { grid-template-columns:repeat(2,1fr); } }
  @media (min-width:1024px) { .benefits-list { grid-template-columns:repeat(3,1fr); } }

  .benefit-block { padding:1.5rem; }
  .bb-icon {
    width:48px;height:48px;border-radius:var(--radius-lg);
    background:var(--color-primary-50);color:var(--color-primary);
    display:flex;align-items:center;justify-content:center;margin-bottom:1rem;
  }
  .benefit-block h3 { font-size:1rem;margin:0 0 0.5rem; }
  .benefit-block p  { font-size:0.875rem;color:var(--color-text-muted);margin:0;line-height:1.65; }

  .plans-grid {
    display:grid;grid-template-columns:1fr;gap:1.5rem;max-width:960px;margin-inline:auto;
  }
  @media (min-width:768px) { .plans-grid { grid-template-columns:repeat(3,1fr); } }

  .plan-card { overflow:visible;position:relative; }
  .plan-card.featured { transform:scale(1.03);box-shadow:var(--shadow-card-hover); }
  .plan-badge {
    position:absolute;top:-12px;left:50%;transform:translateX(-50%);
    background:var(--color-primary);color:#fff;
    font-size:0.75rem;font-weight:700;padding:0.3rem 1rem;
    border-radius:var(--radius-full);white-space:nowrap;
  }
  .plan-header { padding:1.5rem;text-align:center;border-radius:var(--radius-xl) var(--radius-xl) 0 0; }
  .plan-name  { font-size:1.0625rem;font-weight:700;color:#fff;margin:0 0 0.75rem; }
  .plan-price { display:flex;align-items:flex-end;justify-content:center;gap:0.25rem; }
  .plan-amt   { font-size:2.25rem;font-weight:800;color:#fff;line-height:1; }
  .plan-period{ font-size:0.875rem;color:rgba(255,255,255,0.75);margin-bottom:0.25rem; }

  .plan-body { padding:1.5rem; }
  .plan-list  { list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.625rem; }
  .plan-list li { display:flex;align-items:flex-start;gap:0.625rem;font-size:0.9rem;color:var(--color-text); }

  .faq-list { display:flex;flex-direction:column;gap:0.75rem;max-width:720px;margin-inline:auto; }
  .faq-item { padding:0; }
  .faq-q {
    display:flex;justify-content:space-between;align-items:center;gap:1rem;
    padding:1.25rem 1.5rem;cursor:pointer;
    font-weight:600;font-size:0.9375rem;color:var(--color-text);
    list-style:none;
  }
  .faq-q::-webkit-details-marker { display:none; }
  .faq-arrow { flex-shrink:0;transition:transform 0.25s; }
  details[open] .faq-arrow { transform:rotate(180deg); }
  .faq-a { padding:0 1.5rem 1.25rem;color:var(--color-text-muted);line-height:1.7;margin:0;font-size:0.9375rem; }
</style>
