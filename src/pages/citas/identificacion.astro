---
import AppointmentLayout from '@/layouts/AppointmentLayout.astro';
import AppointmentSummary from '@features/appointments/components/AppointmentSummary.astro';
import Card from '@/components/ui/Card.astro';
import FormField from '@/components/ui/FormField.astro';
import Select from '@/components/ui/Select.astro';
import Input from '@/components/ui/Input.astro';
import Button from '@/components/ui/Button.astro';
---

<AppointmentLayout
        title="Identifícate"
        description="Identifícate para continuar con la reserva de tu cita."
        noindex={true}
>
    <section class="container py-10 md:py-16">
        <div class="mx-auto grid max-w-4xl gap-6 lg:grid-cols-[1fr_340px]">
            <!-- Form card -->
            <Card padding="lg">
                <p class="mb-1 text-sm font-semibold text-primary">Reserva de cita</p>
                <h1 class="mb-2 text-2xl font-bold text-text md:text-3xl">
                    Identifícate para continuar
                </h1>
                <p class="mb-7 text-text-muted">
                    Ingresa tu documento para reconocerte o crear tu cuenta.
                </p>

                <div class="grid gap-4 sm:grid-cols-[150px_1fr]">
                    <FormField label="Tipo de documento" for="document-type">
                        <Select id="document-type">
                            <option>D.N.I</option>
                            <option>C.E</option>
                            <option>Pasaporte</option>
                        </Select>
                    </FormField>

                    <FormField label="N° de documento" for="document-number">
                        <Input
                                id="document-number"
                                type="text"
                                inputmode="numeric"
                                maxlength={12}
                                placeholder="Ej. 44324600"
                        />
                    </FormField>
                </div>

                <p id="document-error" class="mt-2 hidden text-sm text-danger">
                    Ingresa un número de documento válido.
                </p>

                <Button type="button" id="continue-btn" size="lg" class="mt-7 w-full sm:w-auto">
                    Continuar
                    <i class="ti ti-arrow-right"></i>
                </Button>
            </Card>

            <!-- Summary -->
            <AppointmentSummary class="h-fit"/>
        </div>
    </section>
</AppointmentLayout>

<script>
    import { findAccountByDocument } from '@features/appointments/accounts';
    import { getAppointment, saveAppointment } from '@features/appointments/store';

    const REGISTER_URL = '/citas/registro';
    const PATIENT_URL = '/citas/paciente';

    const input = document.getElementById('document-number') as HTMLInputElement;
    const error = document.getElementById('document-error');

    document.getElementById('continue-btn')?.addEventListener('click', () => {
        const doc = input.value.trim();
        if (!doc) {
            error?.classList.remove('hidden');
            input.focus();
            return;
        }
        error?.classList.add('hidden');

        const appointment = getAppointment();
        if (!appointment) {
            // No appointment selected: send back to listing.
            window.location.href = '/citas';
            return;
        }

        appointment.documentNumber = doc;
        const account = findAccountByDocument(doc);

        if (account) {
            appointment.account = account;
            appointment.patientName = `${ account.firstName } ${ account.lastName }`;
            saveAppointment(appointment);
            window.location.href = PATIENT_URL;
        } else {
            saveAppointment(appointment);
            window.location.href = REGISTER_URL;
        }
    });

    input?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') document.getElementById('continue-btn')?.dispatchEvent(new Event('click'));
    });
</script>
