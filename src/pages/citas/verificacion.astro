---
import AppointmentLayout from '@/layouts/AppointmentLayout.astro';
import AppointmentSummary from '@features/appointments/components/AppointmentSummary.astro';
import Card from '@/components/ui/Card.astro';
import Button from '@/components/ui/Button.astro';

const otpBoxClass =
    'size-14 rounded-xl border-[1.5px] border-primary-100 text-center text-2xl font-semibold text-text outline-none transition-colors focus:border-primary';
---

<AppointmentLayout
        title="Confirma tu identidad"
        description="Confirma tu identidad para continuar con la reserva de tu cita."
        noindex={true}
>
    <section class="container py-10 md:py-16">
        <div class="mx-auto grid max-w-4xl gap-6 lg:grid-cols-[1fr_340px]">
            <!-- Verification card -->
            <Card padding="lg" class="text-center">
                <div class="mx-auto mb-5 flex size-16 items-center justify-center rounded-full bg-primary-50">
                    <i class="ti ti-shield-lock text-3xl text-primary"></i>
                </div>

                <h1 class="mb-3 text-2xl font-bold text-text md:text-3xl">
                    Confirma <span class="text-primary">tu identidad</span>
                </h1>
                <p class="mx-auto mb-7 max-w-md text-text-muted">
                    Enviamos un código de confirmación a tu correo
                    <strong class="text-text" data-mask="email">die**********@gmail.com</strong>
                </p>

                <div class="mb-7 flex justify-center gap-3" id="otp-row">
                    <input class={ otpBoxClass } type="text" inputmode="numeric" maxlength="1" aria-label="Dígito 1"/>
                    <input class={ otpBoxClass } type="text" inputmode="numeric" maxlength="1" aria-label="Dígito 2"/>
                    <input class={ otpBoxClass } type="text" inputmode="numeric" maxlength="1" aria-label="Dígito 3"/>
                    <input class={ otpBoxClass } type="text" inputmode="numeric" maxlength="1" aria-label="Dígito 4"/>
                </div>

                <div class="mx-auto flex max-w-sm flex-col gap-3">
                    <Button type="button" id="resend-email" size="md">
                        <i class="ti ti-mail"></i>
                        Reenviar correo electrónico
                    </Button>
                    <Button type="button" id="send-sms" variant="outline" size="md">
                        <i class="ti ti-device-mobile"></i>
                        Enviar al celular 92*****67
                    </Button>
                </div>

                <p class="mt-7 text-sm text-text-muted">
                    Si no reconoces tu correo o celular, llama al
                    <strong class="text-text">(01) 715 4600</strong> para actualizar tus datos.
                </p>
            </Card>

            <!-- Summary -->
            <AppointmentSummary class="h-fit"/>
        </div>
    </section>
</AppointmentLayout>

<script>
    import { getAppointment } from '@features/appointments/store';

    const NEXT_URL = '/citas/paciente';

    // Masked email from the registered account
    const appointment = getAppointment();
    const email = appointment?.account?.email;
    if (email) {
        const [user, domain] = email.split('@');
        const masked = `${ user.slice(0, 3) }${ '*'.repeat(Math.max(0, user.length - 3)) }@${ domain }`;
        const el = document.querySelector<HTMLElement>('[data-mask="email"]');
        if (el) el.textContent = masked;
    }

    // OTP auto-advance + submit on complete
    const boxes = Array.from(document.querySelectorAll<HTMLInputElement>('#otp-row input'));
    boxes.forEach((box, i) => {
        box.addEventListener('input', () => {
            box.value = box.value.replace(/\D/g, '');
            if (box.value && i < boxes.length - 1) boxes[i + 1].focus();
            if (boxes.every((b) => b.value)) {
                window.location.href = NEXT_URL;
            }
        });
        box.addEventListener('keydown', (e) => {
            if (e.key === 'Backspace' && !box.value && i > 0) boxes[i - 1].focus();
        });
    });

    document.getElementById('resend-email')?.addEventListener('click', () => {
        // TODO: call resend endpoint
    });
    document.getElementById('send-sms')?.addEventListener('click', () => {
        // TODO: call SMS endpoint
    });
</script>
