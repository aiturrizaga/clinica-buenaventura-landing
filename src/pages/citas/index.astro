---
import PageLayout from '@layouts/PageLayout.astro';
import AppointmentHeader from '@features/appointments/components/AppointmentHeader.astro';
import AppointmentDoctorCard from '@features/appointments/components/AppointmentDoctorCard.astro';
import AppointmentConfirmDialog from '@features/appointments/components/AppointmentConfirmDialog.astro';
import Loader from '@/components/ui/Loader.astro';
import { getDoctors } from '@features/doctors/data';
import { getBranchBySlug } from '@features/appointments/branches';
import { ROUTES } from '@config/routes';
import { getSite } from '@config/site';

const params = Astro.url.searchParams;
const branchSlug = params.get('branch') ?? 'lima-sjm';
const specialtySlug = params.get('specialty') ?? 'cardiologia';

const branch = getBranchBySlug(branchSlug);
const doctors = await getDoctors();
const SITE = await getSite();
---

<PageLayout
        title="Reserva de tu cita"
        description="Reserva tu cita médica en línea en Clínica Buenaventura."
        canonical={`${SITE.url}${ROUTES.citas.index}`}
>
    <AppointmentHeader branch={ branchSlug } specialty={ specialtySlug }/>

    <section class="py-6">
        <div class="container max-w-300">
            { doctors.map((doctor) => (
                    <AppointmentDoctorCard doctor={ doctor } address={ branch?.address }/>
            )) }
        </div>
    </section>

    <Loader text="Consultando información de la cita..."/>
    <AppointmentConfirmDialog/>
</PageLayout>

<script>
    import { getBranchBySlug } from '@features/appointments/branches';
    import { saveAppointment, type SelectedAppointment } from '@features/appointments/store';
    import { formatDate, formatTime } from '@lib/utils/date';

    // TODO: set the real next step route when defined.
    const NEXT_STEP_URL = '/citas/identificacion';

    const branchSlug = new URLSearchParams(window.location.search).get('branch') ?? 'lima-sjm';
    const branch = getBranchBySlug(branchSlug);

    const loader = document.getElementById('loader');
    const dialog = document.getElementById('appointment-confirm');
    let pending: SelectedAppointment | null = null;

    // ----- Date tabs per card -----
    document.querySelectorAll<HTMLElement>('[data-doctor]').forEach((card) => {
        const tabs = card.querySelectorAll<HTMLElement>('[data-date][role="tab"]');
        const grids = card.querySelectorAll<HTMLElement>('[data-slots]');

        tabs.forEach((tab) => {
            tab.addEventListener('click', () => {
                const iso = tab.dataset.date;
                tabs.forEach((t) => {
                    const active = t === tab;
                    t.classList.toggle('border-primary', active);
                    t.classList.toggle('border-b-transparent', active);
                    t.classList.toggle('bg-primary-100', active);
                    t.classList.toggle('border-primary-light', !active);
                    t.classList.toggle('bg-white', !active);
                });
                grids.forEach((g) => g.classList.toggle('hidden', g.dataset.slots !== iso));
            });
        });
    });

    // ----- Slot selection -> loader -> dialog -----
    document.querySelectorAll<HTMLElement>('[data-time]').forEach((slot) => {
        slot.addEventListener('click', () => {
            const card = slot.closest<HTMLElement>('[data-doctor]');
            if (!card || !loader || !dialog) return;

            document.querySelectorAll('[data-time][data-selected]').forEach((s) =>
                s.removeAttribute('data-selected')
            );
            slot.setAttribute('data-selected', '');

            pending = {
                doctorSlug: card.dataset.doctor ?? '',
                doctorName: card.dataset.doctorName ?? '',
                specialty: card.dataset.doctorSpecialty ?? '',
                branchSlug,
                branchName: branch?.name ?? '',
                type: 'Presencial',
                dateIso: slot.dataset.date ?? '',
                time: slot.dataset.time ?? '',
            };

            loader.classList.remove('hidden');
            setTimeout(() => {
                loader.classList.add('hidden');
                fillDialog(pending!);
                dialog.classList.remove('hidden');
            }, 1100);
        });
    });

    function fillDialog(data: SelectedAppointment) {
        if (!dialog) return;
        const set = (field: string, value: string) => {
            const el = dialog.querySelector<HTMLElement>(`[data-field="${ field }"]`);
            if (el) el.textContent = value;
        };
        set('doctor', data.doctorName);
        set('branch', data.branchName);
        set('specialty', data.specialty);
        set('datetime', `${ formatDate(data.dateIso) } | ${ formatTime(data.time) }`);
        set('type', data.type);
    }

    // ----- Dialog actions -----
    function closeDialog() {
        dialog?.classList.add('hidden');
    }

    dialog?.querySelector('[data-action="cancel"]')?.addEventListener('click', () => {
        closeDialog();
        document.querySelectorAll('[data-time][data-selected]').forEach((s) =>
            s.removeAttribute('data-selected')
        );
        pending = null;
    });

    dialog?.querySelector('[data-action="confirm"]')?.addEventListener('click', () => {
        if (!pending) return;
        saveAppointment(pending);
        window.location.href = NEXT_STEP_URL;
    });
</script>
