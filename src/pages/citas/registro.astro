---
import AppointmentLayout from '@/layouts/AppointmentLayout.astro';
import AppointmentSummary from '@features/appointments/components/AppointmentSummary.astro';
import Card from '@/components/ui/Card.astro';
import FormField from '@/components/ui/FormField.astro';
import Select from '@/components/ui/Select.astro';
import Input from '@/components/ui/Input.astro';
import Button from '@/components/ui/Button.astro';
---

<AppointmentLayout
        title="Crea tu cuenta"
        description="Regístrate para continuar con la reserva de tu cita."
        noindex={true}
>
    <section class="container py-10 md:py-16">
        <div class="mx-auto grid max-w-4xl gap-6 lg:grid-cols-[1fr_340px]">
            <!-- Form card -->
            <Card padding="lg">
                <p class="mb-1 text-sm font-semibold text-primary">Reserva de cita</p>
                <h1 class="mb-2 text-2xl font-bold text-text md:text-3xl">Crea tu cuenta</h1>
                <p class="mb-7 text-text-muted">No encontramos una cuenta con ese documento. Completa tus datos para
                    continuar.</p>

                <form id="register-form" novalidate class="grid gap-4">
                    <div class="grid gap-4 sm:grid-cols-[150px_1fr]">
                        <FormField label="Tipo de documento" for="reg-document-type">
                            <Select id="reg-document-type">
                                <option>D.N.I</option>
                                <option>C.E</option>
                            </Select>
                        </FormField>
                        <FormField label="N° de documento" for="reg-document-number">
                            <Input id="reg-document-number" type="text" inputmode="numeric"/>
                        </FormField>
                    </div>

                    <FormField label="Nombres" for="reg-first-name">
                        <Input id="reg-first-name" type="text" autocomplete="given-name"/>
                    </FormField>

                    <div class="grid gap-4 sm:grid-cols-2">
                        <FormField label="Apellido paterno" for="reg-last-name-p">
                            <Input id="reg-last-name-p" type="text"/>
                        </FormField>
                        <FormField label="Apellido materno" for="reg-last-name-m">
                            <Input id="reg-last-name-m" type="text"/>
                        </FormField>
                    </div>

                    <div class="grid gap-4 sm:grid-cols-2">
                        <FormField label="Fecha de nacimiento" for="reg-birthdate">
                            <Input id="reg-birthdate" type="text" placeholder="dd/mm/aaaa"/>
                        </FormField>
                        <FormField label="Sexo" for="reg-sex">
                            <Select id="reg-sex">
                                <option>Hombre</option>
                                <option>Mujer</option>
                            </Select>
                        </FormField>
                    </div>

                    <FormField label="Correo electrónico" for="reg-email">
                        <Input id="reg-email" type="email" autocomplete="email"/>
                    </FormField>
                    <FormField label="Celular" for="reg-phone">
                        <Input id="reg-phone" type="tel" autocomplete="tel"/>
                    </FormField>

                    <h2 class="mt-2 text-xl font-bold text-text">
                        Crea tu <span class="text-primary">contraseña</span>
                    </h2>
                    <div class="grid gap-4 sm:grid-cols-2">
                        <FormField label="Crea una contraseña" for="reg-password">
                            <Input id="reg-password" type="password" autocomplete="new-password"/>
                        </FormField>
                        <FormField label="Confirma tu contraseña" for="reg-password-confirm">
                            <Input id="reg-password-confirm" type="password" autocomplete="new-password"/>
                        </FormField>
                    </div>

                    <label class="mt-1 flex items-center gap-2 text-sm text-text-muted">
                        <input id="reg-terms" type="checkbox" class="size-4 accent-primary"/>
                        <span>Acepto los <a class="font-semibold text-primary hover:underline" href="/terminos">términos y condiciones</a></span>
                    </label>

                    <p id="register-error" class="hidden text-sm text-danger"></p>

                    <Button type="submit" size="lg" class="mt-2 w-full sm:w-auto sm:self-start">
                        Continuar
                        <i class="ti ti-arrow-right"></i>
                    </Button>
                </form>
            </Card>

            <!-- Summary -->
            <AppointmentSummary class="h-fit"/>
        </div>
    </section>
</AppointmentLayout>

<script>
    import { getAppointment, saveAppointment, type PatientAccount } from '@features/appointments/store';

    const VERIFICATION_URL = '/citas/verificacion';

    const form = document.getElementById('register-form') as HTMLFormElement;
    const error = document.getElementById('register-error');

    const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();

    // Prefill document number from previous step
    const appointment = getAppointment();
    if (appointment?.documentNumber) {
        (document.getElementById('reg-document-number') as HTMLInputElement).value = appointment.documentNumber;
    }

    const showError = (msg: string) => {
        if (!error) return;
        error.textContent = msg;
        error.classList.remove('hidden');
    };

    form?.addEventListener('submit', (e) => {
        e.preventDefault();

        const firstName = val('reg-first-name');
        const lastNameP = val('reg-last-name-p');
        const lastNameM = val('reg-last-name-m');
        const terms = (document.getElementById('reg-terms') as HTMLInputElement).checked;
        const password = val('reg-password');
        const passwordConfirm = val('reg-password-confirm');

        if (!firstName || !lastNameP) return showError('Completa tus nombres y apellidos.');
        if (password && password !== passwordConfirm) return showError('Las contraseñas no coinciden.');
        if (!terms) return showError('Debes aceptar los términos y condiciones.');

        error?.classList.add('hidden');

        const lastName = `${ lastNameP } ${ lastNameM }`.trim();
        const account: PatientAccount = {
            firstName,
            lastName,
            documentType: 'D.N.I',
            documentNumber: val('reg-document-number'),
            phone: val('reg-phone'),
            email: val('reg-email'),
        };

        const current = getAppointment();
        if (!current) {
            window.location.href = '/citas';
            return;
        }
        current.account = account;
        current.patientName = `${ firstName } ${ lastName }`.trim();
        saveAppointment(current);
        window.location.href = VERIFICATION_URL;
    });
</script>
