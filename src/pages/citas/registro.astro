---
import AppointmentLayout from '@/layouts/AppointmentLayout.astro';
import AppointmentSummary from '@/components/appointment/AppointmentSummary.astro';

const labelClass = 'mb-1.5 block text-sm font-medium text-text';
const selectWrap = 'relative';
const chevron = 'ti ti-chevron-down pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-primary';
---

<AppointmentLayout
        title="Crea tu cuenta | Clínica Buenaventura"
        description="Regístrate para continuar con la reserva de tu cita."
>
    <section class="container py-10 md:py-16">
        <div class="mx-auto grid max-w-4xl gap-6 lg:grid-cols-[1fr_340px]">
            <!-- Form card -->
            <div class="card p-7 md:p-9">
                <p class="mb-1 text-sm font-semibold text-primary">Reserva de cita</p>
                <h1 class="mb-2 text-2xl font-bold text-text md:text-3xl">Crea tu cuenta</h1>
                <p class="mb-7 text-text-muted">No encontramos una cuenta con ese documento. Completa tus datos para
                    continuar.</p>

                <form id="register-form" novalidate class="grid gap-4">
                    <div class="grid gap-4 sm:grid-cols-[150px_1fr]">
                        <div>
                            <label class={ labelClass } for="reg-document-type">Tipo de documento</label>
                            <div class={ selectWrap }>
                                <select id="reg-document-type" class="form-input appearance-none pr-10">
                                    <option>D.N.I</option>
                                    <option>C.E</option>
                                </select>
                                <i class={ chevron }></i>
                            </div>
                        </div>
                        <div>
                            <label class={ labelClass } for="reg-document-number">N° de documento</label>
                            <input id="reg-document-number" type="text" inputmode="numeric" class="form-input"/>
                        </div>
                    </div>

                    <div>
                        <label class={ labelClass } for="reg-first-name">Nombres</label>
                        <input id="reg-first-name" type="text" autocomplete="given-name" class="form-input"/>
                    </div>

                    <div class="grid gap-4 sm:grid-cols-2">
                        <div>
                            <label class={ labelClass } for="reg-last-name-p">Apellido paterno</label>
                            <input id="reg-last-name-p" type="text" class="form-input"/>
                        </div>
                        <div>
                            <label class={ labelClass } for="reg-last-name-m">Apellido materno</label>
                            <input id="reg-last-name-m" type="text" class="form-input"/>
                        </div>
                    </div>

                    <div class="grid gap-4 sm:grid-cols-2">
                        <div>
                            <label class={ labelClass } for="reg-birthdate">Fecha de nacimiento</label>
                            <input id="reg-birthdate" type="text" placeholder="dd/mm/aaaa" class="form-input"/>
                        </div>
                        <div>
                            <label class={ labelClass } for="reg-sex">Sexo</label>
                            <div class={ selectWrap }>
                                <select id="reg-sex" class="form-input appearance-none pr-10">
                                    <option>Hombre</option>
                                    <option>Mujer</option>
                                </select>
                                <i class={ chevron }></i>
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class={ labelClass } for="reg-email">Correo electrónico</label>
                        <input id="reg-email" type="email" autocomplete="email" class="form-input"/>
                    </div>
                    <div>
                        <label class={ labelClass } for="reg-phone">Celular</label>
                        <input id="reg-phone" type="tel" autocomplete="tel" class="form-input"/>
                    </div>

                    <h2 class="mt-2 text-xl font-bold text-text">
                        Crea tu <span class="text-primary">contraseña</span>
                    </h2>
                    <div class="grid gap-4 sm:grid-cols-2">
                        <div>
                            <label class={ labelClass } for="reg-password">Crea una contraseña</label>
                            <input id="reg-password" type="password" autocomplete="new-password" class="form-input"/>
                        </div>
                        <div>
                            <label class={ labelClass } for="reg-password-confirm">Confirma tu contraseña</label>
                            <input id="reg-password-confirm" type="password" autocomplete="new-password"
                                   class="form-input"/>
                        </div>
                    </div>

                    <label class="mt-1 flex items-center gap-2 text-sm text-text-muted">
                        <input id="reg-terms" type="checkbox" class="size-4 accent-primary"/>
                        <span>Acepto los <a class="font-semibold text-primary hover:underline" href="/terminos">términos y condiciones</a></span>
                    </label>

                    <p id="register-error" class="hidden text-sm text-danger"></p>

                    <button
                            type="submit"
                            class="cursor-pointer mt-2 inline-flex w-full items-center justify-center gap-2 rounded-full bg-primary px-6 py-3.5 font-semibold text-white transition-colors hover:bg-primary-dark sm:w-auto sm:self-start"
                    >
                        Continuar
                        <i class="ti ti-arrow-right"></i>
                    </button>
                </form>
            </div>

            <!-- Summary -->
            <AppointmentSummary class="h-fit"/>
        </div>
    </section>
</AppointmentLayout>

<script>
    import { getAppointment, saveAppointment, type PatientAccount } from '@/scripts/appointmentStore';

    const VERIFICATION_URL = '/citas/verificacion';

    const form = document.getElementById('register-form') as HTMLFormElement;
    const error = document.getElementById('register-error');

    const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();

    // Prefill document number from previous step
    const appointment = getAppointment();
    if (appointment?.documentNumber) {
        (document.getElementById('reg-document-number') as HTMLInputElement).value = appointment.documentNumber;
    }

    const showError = (msg: string) => {
        if (!error) return;
        error.textContent = msg;
        error.classList.remove('hidden');
    };

    form?.addEventListener('submit', (e) => {
        e.preventDefault();

        const firstName = val('reg-first-name');
        const lastNameP = val('reg-last-name-p');
        const lastNameM = val('reg-last-name-m');
        const terms = (document.getElementById('reg-terms') as HTMLInputElement).checked;
        const password = val('reg-password');
        const passwordConfirm = val('reg-password-confirm');

        if (!firstName || !lastNameP) return showError('Completa tus nombres y apellidos.');
        if (password && password !== passwordConfirm) return showError('Las contraseñas no coinciden.');
        if (!terms) return showError('Debes aceptar los términos y condiciones.');

        error?.classList.add('hidden');

        const lastName = `${ lastNameP } ${ lastNameM }`.trim();
        const account: PatientAccount = {
            firstName,
            lastName,
            documentType: 'D.N.I',
            documentNumber: val('reg-document-number'),
            phone: val('reg-phone'),
            email: val('reg-email'),
        };

        const current = getAppointment();
        if (!current) {
            window.location.href = '/citas';
            return;
        }
        current.account = account;
        current.patientName = `${ firstName } ${ lastName }`.trim();
        saveAppointment(current);
        window.location.href = VERIFICATION_URL;
    });
</script>
