---
import PageLayout from '../layouts/PageLayout.astro';

const links = [
    { label: 'Especialidades', href: '/especialidades', icon: 'ti ti-stethoscope' },
    { label: 'Médicos', href: '/medicos', icon: 'ti ti-user-heart' },
    { label: 'Nosotros', href: '/nosotros', icon: 'ti ti-building-hospital' },
    { label: 'Promociones', href: '/promociones', icon: 'ti ti-tag' },
];
---

<PageLayout
        title="Página no encontrada"
        description="La página que buscas no existe. Vuelve al inicio o contáctanos."
        noindex={ true }
>
    <section class="min-h-[75vh] flex items-center bg-linear-to-br from-primary-50 to-white py-20">
        <div class="container">
            <div class="max-w-lg mx-auto text-center">

                <!-- 404 -->
                <p class="text-[10rem] font-black leading-none text-primary opacity-10 select-none mb-8">
                    404
                </p>

                <!-- Icon -->
                <div class="inline-flex items-center justify-center size-20 rounded-full bg-primary-50 text-primary mb-2">
                    <i class="ti ti-mood-sad text-5xl"></i>
                </div>

                <!-- Text -->
                <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-4">
                    Página no encontrada
                </h1>
                <p class="text-gray-500 text-lg leading-relaxed mb-8">
                    Lo sentimos, la página que buscas no existe o fue movida.<br/>
                    Te invitamos a volver al inicio.
                </p>

                <!-- CTA -->
                <a href="/" class="btn btn-primary btn-lg mb-12">
                    <i class="ti ti-arrow-left"></i>
                    Volver al inicio
                </a>

                <!-- Quick links -->
                <div>
                    <p class="text-xs font-bold tracking-widest uppercase text-gray-400 mb-4">
                        Páginas populares
                    </p>
                    <div class="flex flex-wrap gap-2 justify-center">
                        { links.map(({ label, href, icon }) => (
                                <a href={ href }
                                   class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary bg-primary-50 hover:bg-primary hover:text-white! px-4 py-2 rounded-full transition-colors duration-200">
                                    <i class={ icon }></i>
                                    { label }
                                </a>
                        )) }
                    </div>
                </div>

            </div>
        </div>
    </section>
</PageLayout>
