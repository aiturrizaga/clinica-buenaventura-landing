---
import PageLayout from '../../layouts/PageLayout.astro';
import { promotions } from '@data/promotions.ts';

const PHONE = '51932939530';

export function getStaticPaths() {
    return promotions.map((promo) => ({
        params: { slug: promo.slug },
        props: { promo },
    }));
}

const { promo } = Astro.props;
const detail = promo.detail;

function waLink(text: string) {
    return `https://wa.me/${ PHONE }?text=${ encodeURIComponent(text) }`;
}
---

<PageLayout
        title={ `${ promo.title } | Clínica Buenaventura` }
        description={ `Conoce más sobre ${ promo.title } en Clínica Buenaventura.` }
>
    <!-- Banner -->
    <div class="bg-linear-to-br from-primary-50 to-white py-14">
        <div class="container">
            <nav class="flex items-center gap-2 text-sm text-gray-400 mb-4" aria-label="Breadcrumb">
                <a href="/" class="text-primary hover:underline">Inicio</a>
                <span>/</span>
                <a href="/promociones" class="text-primary hover:underline">Promociones</a>
                <span>/</span>
                <span aria-current="page">{ promo.title }</span>
            </nav>
            <h1 class="text-4xl font-extrabold text-gray-900 mb-2">{ promo.title }</h1>
        </div>
    </div>

    <!-- Detail -->
    <section class="py-14 bg-white">
        <div class="container max-w-3xl">

            <!-- Imagen -->
            <div class="rounded-2xl overflow-hidden shadow-md mb-8">
                <img
                        src={ promo.image }
                        alt={ promo.title }
                        class="w-full h-auto block"
                        loading="eager"
                />
            </div>

            <!-- CTA -->
            <div class="flex justify-center mb-10">
                <a href={ waLink(promo.waMessage ?? `Hola, me interesa la promoción: ${ promo.title }`) }
                   target="_blank"
                   rel="noopener noreferrer"
                   class="inline-flex items-center gap-2 bg-primary hover:bg-primary-dark text-white! font-bold text-base
                          px-8 py-3 rounded-full transition-colors duration-200 shadow-sm"
                >
                    { promo.ctaText }
                </a>
            </div>

            <!-- Info -->
            { detail && (
                    <div class="detail-block space-y-6">

                        <!-- Highlights -->
                        { detail.highlights && (
                                <ul class="space-y-3">
                                    { detail.highlights.map((item) => (
                                            <li class="flex items-center justify-start gap-3 bg-primary-50 rounded-xl px-4 py-3">
                                                <span class="text-xl shrink-0 mt-0.5">{ item.icon }</span>
                                                <span class="text-gray-700 text-sm leading-relaxed"
                                                      set:html={ item.text }/>
                                            </li>
                                    )) }
                                </ul>
                        ) }

                        <!-- Important -->
                        { detail.important && (
                                <div class="flex items-start gap-3 border-l-4 border-primary bg-primary-50/60 rounded-r-xl px-4 py-3">
                                    <span class="text-xl shrink-0 mt-0.5">☝️</span>
                                    <div>
                                        <p class="text-sm font-bold text-gray-800 uppercase tracking-wide mb-1">
                                            ¡Importante!</p>
                                        <p class="text-sm text-gray-700 leading-relaxed" set:html={ detail.important }/>
                                    </div>
                                </div>
                        ) }

                        <!-- T&C -->
                        { detail.termsUrl && (
                                <div class="text-center">
                                    <a href={ detail.termsUrl }
                                       class="inline-flex items-center gap-1.5 text-sm text-primary hover:text-primary-dark!">
                                        <span class="underline">Ver términos y condiciones completos</span>
                                        <i class="ti ti-arrow-right"></i>
                                    </a>
                                </div>
                        ) }

                        <!-- Legal -->
                        { detail.legal && (
                                <p class="text-xs text-gray-400 text-center leading-relaxed">
                                    * { detail.legal }
                                </p>
                        ) }

                    </div>
            ) }

        </div>
    </section>
</PageLayout>
