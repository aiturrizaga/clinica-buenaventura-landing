---
import PageLayout from '../../layouts/PageLayout.astro';
import { getPromotions } from '@features/promotions/data';
import { getSite } from '@config/site';
import { whatsappLink, WHATSAPP_MESSAGES } from '@config/social';

const promotions = await getPromotions();
const site = await getSite();
---
<PageLayout
        title="Promociones"
        description="Descubre las últimas promociones y descuentos en consultas y servicios de Clínica Buenaventura. Ahorra en tu salud."
>
    <!-- Banner -->
    <div class="bg-linear-to-br from-primary-50 to-white py-14">
        <div class="container">
            <nav class="flex items-center gap-2 text-sm text-gray-400 mb-4" aria-label="Breadcrumb">
                <a href="/" class="text-primary hover:underline">Inicio</a>
                <span>/</span>
                <span aria-current="page">Promociones</span>
            </nav>
            <h1 class="text-4xl font-extrabold text-gray-900 mb-2">Promociones</h1>
            <p class="text-gray-500 text-lg">Descuentos y ofertas especiales para cuidar tu salud al mejor precio</p>
        </div>
    </div>

    <!-- Grid -->
    <section class="py-14 bg-white">
        <div class="container">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                { promotions.map((promo, i) => (
                        <article
                                class="reveal rounded-2xl overflow-hidden shadow-md hover:-translate-y-1 transition-transform duration-300"
                                style={ `animation-delay:${ i * 0.1 }s` }
                                aria-label={ promo.title }
                        >
                            <!-- Imagen -->
                            <div class="w-full aspect-video overflow-hidden">
                                <a href={ `/promociones/${ promo.slug }` }>
                                    <img
                                            src={ promo.image }
                                            alt={ promo.title }
                                            loading="lazy"
                                            decoding="async"
                                            class="w-full h-full object-cover transition-transform duration-500 hover:scale-[1.03]"
                                    />
                                </a>
                            </div>

                            <!-- Botón WhatsApp -->
                            <div class="p-4 bg-white flex justify-center">
                                <a
                                        href={ whatsappLink(site.contact.whatsapp, promo.waMessage ?? WHATSAPP_MESSAGES.promotion(promo.title)) }
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="inline-flex items-center gap-2 bg-primary hover:bg-primary-dark text-white! font-bold text-sm px-5 py-2.5 rounded-full transition-colors duration-200 shadow-sm"
                                >
                                    Aprovechar promoción
                                </a>
                            </div>
                        </article>
                )) }
            </div>
        </div>
    </section>

    <!-- Nota legal -->
    <section class="bg-surface py-8">
        <div class="container">
            <p class="text-xs text-gray-400 text-center max-w-xl mx-auto">
                * Los descuentos aplican sobre el precio regular de consulta o servicio. No acumulables con otras
                promociones.
                Sujeto a disponibilidad de agenda. Para más información comunícate con nosotros.
            </p>
        </div>
    </section>
</PageLayout>
