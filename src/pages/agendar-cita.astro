---
import PageLayout from '../layouts/PageLayout.astro';
import { specialties } from '../data/specialties';
import { doctors } from '../data/doctors';

const urlParams = Astro.url.searchParams;
const preDoctor    = urlParams.get('doctor') ?? '';
const preSpec      = urlParams.get('especialidad') ?? '';
---
<PageLayout
  title="Agendar Cita | Clínica Buenaventura"
  description="Agenda tu cita médica en línea en Clínica Buenaventura. Selecciona especialidad, médico, fecha y horario disponible de forma fácil y rápida."
>
  <section class="appt-section">
    <div class="container">
      <div class="appt-wrap">
        <div class="appt-header">
          <h1>Agenda tu cita</h1>
          <p>Completa el formulario en 4 pasos simples</p>
        </div>

        <!-- Progress -->
        <div class="progress-bar" role="progressbar" aria-valuenow={1} aria-valuemin={1} aria-valuemax={4} aria-label="Paso 1 de 4">
          {['Especialidad','Médico','Fecha','Datos'].map((label, i) => (
            <div class:list={['step', { active: i===0, done: false }]} id={`step-dot-${i+1}`}>
              <div class="step-circle">{i+1}</div>
              <span class="step-label">{label}</span>
            </div>
          ))}
          <div class="step-line-bg"><div class="step-line-fill" id="step-fill"></div></div>
        </div>

        <!-- Form card -->
        <div class="appt-card card">

          <!-- Step 1 -->
          <div class="step-content" id="step-1">
            <h2>¿Qué especialidad necesitas?</h2>
            <div class="spec-options">
              {specialties.map(s => (
                <label class="option-tile">
                  <input type="radio" name="specialty" value={s.slug} checked={s.slug===preSpec} />
                  <div class="tile-inner">
                    <span class="tile-name">{s.name}</span>
                  </div>
                </label>
              ))}
            </div>
            <button class="btn btn-primary btn-lg next-btn" data-next="2" style="width:100%;justify-content:center;margin-top:1.5rem">
              Continuar →
            </button>
          </div>

          <!-- Step 2 -->
          <div class="step-content hidden" id="step-2">
            <h2>Selecciona tu médico</h2>
            <div class="doctor-options">
              {doctors.map(d => (
                <label class="doctor-option">
                  <input type="radio" name="doctor" value={d.slug} checked={d.slug===preDoctor} />
                  <div class="doc-tile">
                    <img src={d.photo} alt={`${d.title} ${d.name}`} width="48" height="48" loading="lazy" />
                    <div>
                      <p class="doc-tile-name">{d.title} {d.name}</p>
                      <p class="doc-tile-spec">{d.specialty} · CMP {d.cmp}</p>
                    </div>
                  </div>
                </label>
              ))}
            </div>
            <div class="step-nav">
              <button class="btn btn-outline btn-lg prev-btn" data-prev="1">← Anterior</button>
              <button class="btn btn-primary btn-lg next-btn" data-next="3">Continuar →</button>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="step-content hidden" id="step-3">
            <h2>Elige fecha y hora</h2>
            <div class="date-time-grid">
              <div>
                <label for="appt-date" class="field-label">Fecha de la cita *</label>
                <input
                  type="date"
                  id="appt-date"
                  name="date"
                  class="form-input"
                  min={new Date().toISOString().split('T')[0]}
                  required
                />
              </div>
              <fieldset class="times-fieldset">
                <legend class="field-label">Horario disponible</legend>
                <div class="time-options">
                  {['08:00','09:00','10:00','11:00','14:00','15:00','16:00','17:00'].map(t => (
                    <label class="time-tile">
                      <input type="radio" name="time" value={t} />
                      <span>{t}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            </div>
            <div class="step-nav">
              <button class="btn btn-outline btn-lg prev-btn" data-prev="2">← Anterior</button>
              <button class="btn btn-primary btn-lg next-btn" data-next="4">Continuar →</button>
            </div>
          </div>

          <!-- Step 4 -->
          <div class="step-content hidden" id="step-4">
            <h2>Tus datos de contacto</h2>
            <form id="appt-form" novalidate>
              <div class="form-grid">
                <div class="field">
                  <label for="fname" class="field-label">Nombre *</label>
                  <input id="fname" name="firstName" type="text" class="form-input" required autocomplete="given-name" />
                </div>
                <div class="field">
                  <label for="lname" class="field-label">Apellido *</label>
                  <input id="lname" name="lastName" type="text" class="form-input" required autocomplete="family-name" />
                </div>
              </div>
              <div class="field">
                <label for="email" class="field-label">Correo electrónico *</label>
                <input id="email" name="email" type="email" class="form-input" required autocomplete="email" />
              </div>
              <div class="field">
                <label for="phone" class="field-label">Teléfono / WhatsApp *</label>
                <input id="phone" name="phone" type="tel" class="form-input" required autocomplete="tel" />
              </div>
              <div class="field">
                <label for="notes" class="field-label">Motivo de consulta (opcional)</label>
                <textarea id="notes" name="notes" class="form-input" rows="3" style="resize:vertical"></textarea>
              </div>
              <div class="step-nav" style="margin-top:1.25rem">
                <button type="button" class="btn btn-outline btn-lg prev-btn" data-prev="3">← Anterior</button>
                <button type="submit" class="btn btn-primary btn-lg" style="flex:1">Confirmar cita ✓</button>
              </div>
            </form>
          </div>

          <!-- Success -->
          <div class="step-content hidden" id="step-success">
            <div class="success-wrap">
              <div class="success-icon" aria-hidden="true">
                <svg width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="#fff" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <h2>¡Cita agendada con éxito!</h2>
              <p>Recibirás un correo de confirmación. Nuestro equipo se pondrá en contacto contigo para confirmar los detalles.</p>
              <a href="/" class="btn btn-primary btn-lg">Volver al inicio</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .appt-section {
    background: var(--color-surface);
    padding-block: 4rem;
    min-height: 80vh;
  }
  .appt-wrap { max-width: 680px; margin-inline: auto; }

  .appt-header { text-align:center; margin-bottom:2.5rem; }
  .appt-header h1 { font-size:clamp(1.75rem,3vw,2.5rem);margin:0 0 0.5rem; }
  .appt-header p  { color:var(--color-text-muted);margin:0;font-size:1.0625rem; }

  /* Progress */
  .progress-bar {
    position:relative;display:flex;justify-content:space-between;
    margin-bottom:2.5rem; padding-inline: 0;
  }
  .step { display:flex;flex-direction:column;align-items:center;gap:0.375rem;z-index:1; }
  .step-circle {
    width:36px;height:36px;border-radius:50%;
    border:2px solid #E5E7EB;background:#fff;
    display:flex;align-items:center;justify-content:center;
    font-size:0.875rem;font-weight:700;color:var(--color-text-muted);
    transition:all 0.3s;
  }
  .step.active .step-circle {
    background:var(--color-primary);border-color:var(--color-primary);color:#fff;
  }
  .step.done .step-circle {
    background:var(--color-primary);border-color:var(--color-primary);color:#fff;
  }
  .step-label { font-size:0.75rem;color:var(--color-text-muted);font-weight:500;display:none; }
  @media (min-width:480px) { .step-label { display:block; } }

  .step-line-bg {
    position:absolute;top:18px;left:10%;right:10%;height:2px;background:#E5E7EB;z-index:0;
  }
  .step-line-fill {
    height:100%;background:var(--color-primary);width:0%;transition:width 0.4s ease;
  }

  .appt-card { padding: 2rem; }

  .step-content h2 { font-size:1.375rem;margin:0 0 1.5rem; }

  .spec-options {
    display:grid;grid-template-columns:repeat(2,1fr);gap:0.75rem;
  }
  @media (min-width:480px) { .spec-options { grid-template-columns:repeat(3,1fr); } }

  .option-tile input { position:absolute;opacity:0;pointer-events:none; }
  .option-tile { cursor:pointer; }
  .tile-inner {
    padding:0.875rem;border:2px solid #E5E7EB;border-radius:var(--radius-lg);
    text-align:center;transition:all 0.2s;
  }
  .option-tile input:checked ~ .tile-inner {
    border-color:var(--color-primary);background:var(--color-primary-50);
  }
  .tile-inner:hover { border-color:rgba(10,75,255,0.4); }
  .tile-name { font-size:0.875rem;font-weight:600;color:var(--color-text); }

  .doctor-options { display:flex;flex-direction:column;gap:0.625rem;max-height:360px;overflow-y:auto; }
  .doctor-option input { position:absolute;opacity:0;pointer-events:none; }
  .doctor-option { cursor:pointer; }
  .doc-tile {
    display:flex;align-items:center;gap:0.875rem;
    padding:0.875rem 1rem;border:2px solid #E5E7EB;border-radius:var(--radius-lg);
    transition:all 0.2s;
  }
  .doctor-option input:checked ~ .doc-tile {
    border-color:var(--color-primary);background:var(--color-primary-50);
  }
  .doc-tile img { border-radius:50%;object-fit:cover;flex-shrink:0; }
  .doc-tile-name { font-weight:600;font-size:0.9375rem;color:var(--color-text);margin:0 0 0.1rem; }
  .doc-tile-spec  { font-size:0.8rem;color:var(--color-text-muted);margin:0; }

  .date-time-grid { display:grid;gap:1.5rem; }
  .times-fieldset { border:none;padding:0;margin:0; }
  .time-options {
    display:grid;grid-template-columns:repeat(4,1fr);gap:0.5rem;margin-top:0.5rem;
  }
  .time-tile input { position:absolute;opacity:0;pointer-events:none; }
  .time-tile { cursor:pointer; }
  .time-tile span {
    display:block;text-align:center;padding:0.625rem 0.5rem;
    border:2px solid #E5E7EB;border-radius:var(--radius-md);
    font-size:0.875rem;font-weight:600;color:var(--color-text);
    transition:all 0.2s;
  }
  .time-tile input:checked ~ span {
    border-color:var(--color-primary);background:var(--color-primary-50);color:var(--color-primary);
  }
  .time-tile span:hover { border-color:rgba(10,75,255,0.4); }

  .field { margin-bottom:1.125rem; }
  .field-label { display:block;font-size:0.9rem;font-weight:600;color:var(--color-text);margin-bottom:0.4rem; }
  .form-grid { display:grid;grid-template-columns:1fr 1fr;gap:1rem; }

  .step-nav { display:flex;gap:0.875rem;margin-top:2rem; }
  .step-nav .btn { flex:1;justify-content:center; }

  .hidden { display:none !important; }

  .success-wrap {
    display:flex;flex-direction:column;align-items:center;
    text-align:center;padding:2rem;gap:1rem;
  }
  .success-icon {
    width:80px;height:80px;background:var(--color-success, #10B981);border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 8px 32px rgba(16,185,129,0.3);
  }
  .success-wrap h2 { font-size:1.5rem;margin:0; }
  .success-wrap p  { color:var(--color-text-muted);max-width:380px;margin:0 0 0.5rem; }
</style>

<script>
  const steps = [1,2,3,4];
  let current = 1;

  function showStep(n: number) {
    steps.forEach(s => {
      const el = document.getElementById(`step-${s}`);
      if (el) el.classList.toggle('hidden', s !== n);
      const dot = document.getElementById(`step-dot-${s}`);
      if (dot) {
        dot.classList.toggle('active', s === n);
        dot.classList.toggle('done', s < n);
      }
    });
    const fill = document.getElementById('step-fill') as HTMLElement;
    if (fill) fill.style.width = `${((n-1)/3)*100}%`;
    current = n;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  document.querySelectorAll<HTMLButtonElement>('.next-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const next = parseInt(btn.dataset.next ?? '1');
      showStep(next);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.prev-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const prev = parseInt(btn.dataset.prev ?? '1');
      showStep(prev);
    });
  });

  const form = document.getElementById('appt-form') as HTMLFormElement;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    // show success
    document.getElementById('step-4')?.classList.add('hidden');
    document.getElementById('step-success')?.classList.remove('hidden');
    const fill = document.getElementById('step-fill') as HTMLElement;
    if (fill) fill.style.width = '100%';
  });
</script>
