---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE } from '@config/site';

const values = [
    {
        title: 'Confianza',
        desc: 'Queremos que al entrar aquí sientas que estás en el lugar correcto.',
        fontIcon: 'ti ti-shield-check'
    },
    {
        title: 'Calidad',
        desc: 'Nos esforzamos para que recibas la mejor atención, sin excepciones.',
        fontIcon: 'ti ti-award'
    },
    {
        title: 'Humanidad',
        desc: 'Detrás de cada paciente hay una historia, y nosotros la cuidamos.',
        fontIcon: 'ti ti-heart-handshake'
    },
    {
        title: 'Ética',
        desc: 'Tu salud, nuestra mayor responsabilidad.',
        fontIcon: 'ti ti-scale'
    },
];
---
<PageLayout
        title="Nosotros"
        description="Conoce la misión, visión y valores de Clínica Buenaventura."
        jsonLd={ {
            '@context': 'https://schema.org',
            '@type': 'AboutPage',
            name: 'Sobre Clínica Buenaventura',
            description: 'Misión, visión y valores de Clínica Buenaventura',
        } }
>
    <!-- Banner -->
    <div class="py-20"
         style="background: linear-gradient(to bottom right, var(--color-primary), color-mix(in srgb, var(--color-primary) 60%, #000))">
        <div class="container">
            <nav aria-label="Breadcrumb"
                 class="flex items-center gap-2 text-sm text-white/65 mb-4">
                <a href="/" class="text-white/80 hover:underline">Inicio</a>
                <span>/</span>
                <span aria-current="page">Nosotros</span>
            </nav>
            <h1 class="text-4xl md:text-5xl font-extrabold text-white!">Sobre Nosotros</h1>
        </div>
    </div>

    <!-- Misión / Visión -->
    <section class="py-14 bg-white">
        <div class="container">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="reveal p-8 rounded-2xl border border-gray-200 hover:border-primary hover:shadow-md transition-all duration-300">
                    <div class="w-13 h-13 rounded-xl bg-primary-50 text-primary flex items-center justify-center mb-5 text-2xl">
                        <i class="ti ti-bolt"></i>
                    </div>
                    <h2 class="text-xl font-bold mb-3">Misión</h2>
                    <p class="text-gray-500 leading-relaxed text-sm">
                        Nuestra misión es brindar servicios de salud integrales, accesibles y de calidad, centrados en
                        el paciente y su familia, con un enfoque humano y seguro, respaldado por un equipo profesional
                        comprometido con la confianza, la ética y la mejora continua.
                    </p>
                </div>
                <div class="reveal p-8 rounded-2xl border border-gray-200 hover:border-primary hover:shadow-md transition-all duration-300"
                     style="animation-delay:0.12s">
                    <div class="w-13 h-13 rounded-xl bg-primary-50 text-primary flex items-center justify-center mb-5 text-2xl">
                        <i class="ti ti-eye"></i>
                    </div>
                    <h2 class="text-xl font-bold mb-3">Visión</h2>
                    <p class="text-gray-500 leading-relaxed text-sm">
                        Nuestra visión es ser una institución de salud de referencia en San Juan de Miraflores,
                        reconocida por la confianza de sus pacientes, la calidad de su atención, la eficiencia de sus
                        servicios y su compromiso con la salud de la comunidad.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Values -->
    <section class="py-14 bg-white">
        <div class="container">
            <div class="text-center mb-12 reveal">
                <span class="inline-block text-xs font-bold tracking-widest uppercase text-primary mb-3">Lo que nos define</span>
                <h2 class="text-3xl md:text-4xl font-extrabold">Nuestros Valores</h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                { values.map((v, i) => (
                        <div class="card reveal p-7 text-center" style={ `animation-delay:${ i * 0.1 }s` }>
                            <div class="w-14 h-14 rounded-xl bg-primary-50 text-primary flex items-center justify-center mx-auto mb-4 text-3xl">
                                <i class={ v.fontIcon }></i>
                            </div>
                            <h3 class="text-base font-bold mb-2">{ v.title }</h3>
                            <p class="text-sm text-gray-500 leading-relaxed m-0">{ v.desc }</p>
                        </div>
                )) }
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="bg-primary py-20 text-center">
        <div class="container">
            <h2 class="text-3xl md:text-4xl font-extrabold text-white! mb-4">¿Listo para cuidar tu salud?</h2>
            <p class="text-white/75 text-base mb-8 max-w-md mx-auto">
                Agenda tu cita hoy y experimenta la excelencia médica de Clínica Buenaventura.
            </p>
            <a href={ `https://wa.me/${ SITE.contact.whatsapp }` } class="btn btn-white btn-lg">Agendar mi cita</a>
        </div>
    </section>
</PageLayout>
