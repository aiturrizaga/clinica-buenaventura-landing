---
import PageLayout from '../layouts/PageLayout.astro';

const values = [
    {
        icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
        title: 'Confianza',
        desc: 'Queremos que al entrar aquí sientas que estás en el lugar correcto.',
        fontIcon: 'ti ti-shield-check'
    },
    {
        icon: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
        title: 'Calidad',
        desc: 'Nos esforzamos para que recibas la mejor atención, sin excepciones.',
        fontIcon: 'ti ti-award'
    },
    {
        icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
        title: 'Humanidad',
        desc: 'Detrás de cada paciente hay una historia, y nosotros la cuidamos.',
        fontIcon: 'ti ti-heart-handshake'
    },
    {
        icon: 'M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4',
        title: 'Ética',
        desc: 'Tu salud, nuestra mayor responsabilidad.',
        fontIcon: 'ti ti-scale'
    },
];
---
<PageLayout
        title="Nosotros | Clínica Buenaventura"
        description="Conoce la historia, misión, visión y valores de Clínica Buenaventura."
        jsonLd={ {
            '@context': 'https://schema.org',
            '@type': 'AboutPage',
            name: 'Sobre Clínica Buenaventura',
            description: 'Historia y valores de Clínica Buenaventura',
        } }
>
    <!-- Banner -->
    <div class="about-banner">
        <img
                src="https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=1400&h=500&fit=crop&auto=format"
                alt="Clínica Buenaventura edificio"
                loading="eager"
                width="1400"
                height="500"
        />
        <div class="banner-overlay">
            <div class="container">
                <nav aria-label="Breadcrumb" class="breadcrumb">
                    <a href="/">Inicio</a><span>/</span><span aria-current="page">Nosotros</span>
                </nav>
                <h1>Sobre Nosotros</h1>
                <p>Más de 15 años cuidando tu salud y la de tu familia</p>
            </div>
        </div>
    </div>

    <!-- Misión / Visión -->
    <section class="section-py" style="background:#fff">
        <div class="container">
            <div class="mv-grid">
                <div class="mv-card reveal">
                    <div class="mv-icon">
                        <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                             stroke-width="2" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                        </svg>
                    </div>
                    <h2>Misión</h2>
                    <p>
                        Nuestra misión es brindar servicios de salud integrales, accesibles y de calidad, centrados en
                        el
                        paciente y su familia, con un enfoque humano y seguro, respaldado por un equipo profesional
                        comprometido con la confianza, la ética y la mejora continua.
                    </p>
                </div>
                <div class="mv-card reveal" style="animation-delay:0.12s">
                    <div class="mv-icon">
                        <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                             stroke-width="2" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                    </div>
                    <h2>Visión</h2>
                    <p>
                        Nuestra visión es ser una institución de salud de referencia en San Juan de Miraflores,
                        reconocida por la confianza de sus pacientes, la calidad de su atención, la eficiencia de sus
                        servicios y su compromiso con la salud de la comunidad.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Stats -->
    <section class="stats-section">
        <div class="container">
            <div class="stats-grid">
                { [
                    { value: '+15', label: 'Años de experiencia' },
                    { value: '+20', label: 'Especialidades' },
                    { value: '+10K', label: 'Pacientes atendidos' },
                    { value: '98%', label: 'Satisfacción' },
                ].map(s => (
                        <div class="stat-item reveal">
                            <span class="stat-val">{ s.value }</span>
                            <span class="stat-lbl">{ s.label }</span>
                        </div>
                )) }
            </div>
        </div>
    </section>

    <!-- Values -->
    <section class="section-py" style="background:#fff">
        <div class="container">
            <div style="text-align:center;margin-bottom:3rem" class="reveal">
                <span class="section-label">Lo que nos define</span>
                <h2 class="section-h2">Nuestros Valores</h2>
            </div>
            <div class="values-grid">
                { values.map((v, i) => (
                        <div class="value-card card reveal" style={ `animation-delay:${ i * 0.1 }s` }>
                            <div class="value-icon">

                                <i class={ v.fontIcon }></i>
                            </div>
                            <h3>{ v.title }</h3>
                            <p>{ v.desc }</p>
                        </div>
                )) }
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section style="background:var(--color-primary);padding-block:5rem;text-align:center">
        <div class="container">
            <h2 style="color:#fff;font-size:clamp(1.75rem,3vw,2.5rem);margin:0 0 1rem">¿Listo para cuidar tu salud?</h2>
            <p style="color:rgba(255,255,255,0.75);font-size:1.0625rem;margin:0 0 2rem;max-width:480px;margin-inline:auto">
                Agenda tu cita hoy y experimenta la excelencia médica de Clínica Buenaventura.
            </p>
            <a href="https://wa.me/51932939530" class="btn btn-white btn-lg">Agendar mi cita</a>
        </div>
    </section>
</PageLayout>

<style>
    .about-banner {
        position: relative;
        height: 380px;
        overflow: hidden;
        background: #0D1526;
    }

    .about-banner img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.35;
    }

    .banner-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding-bottom: 3rem;
    }

    .banner-overlay h1 {
        color: #fff;
        font-size: clamp(2rem, 4vw, 3.5rem);
        margin: 0.5rem 0 0.5rem;
    }

    .banner-overlay p {
        color: rgba(255, 255, 255, 0.75);
        font-size: 1.0625rem;
        margin: 0;
    }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        color: rgba(255, 255, 255, 0.65);
    }

    .breadcrumb a {
        color: rgba(255, 255, 255, 0.8);
    }

    .mv-grid {
        display: grid;
        grid-template-columns:1fr;
        gap: 1.5rem;
    }

    @media (min-width: 768px) {
        .mv-grid {
            grid-template-columns:repeat(2, 1fr);
        }
    }

    .mv-card {
        padding: 2rem;
        border-radius: var(--radius-xl);
        border: 1px solid #E5E7EB;
        transition: border-color 0.25s, box-shadow 0.25s;
    }

    .mv-card:hover {
        border-color: var(--color-primary);
        box-shadow: var(--shadow-card);
    }

    .mv-icon {
        width: 52px;
        height: 52px;
        border-radius: var(--radius-lg);
        background: var(--color-primary-50);
        color: var(--color-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.25rem;
    }

    .mv-card h2 {
        font-size: 1.25rem;
        margin: 0 0 0.75rem;
    }

    .mv-card p {
        color: var(--color-text-muted);
        line-height: 1.7;
        margin: 0;
        font-size: 0.9375rem;
    }

    .stats-section {
        background: var(--color-primary);
        padding-block: 4rem;
    }

    .stats-grid {
        display: grid;
        grid-template-columns:repeat(2, 1fr);
        gap: 2rem;
    }

    @media (min-width: 640px) {
        .stats-grid {
            grid-template-columns:repeat(2, 1fr);
        }
    }

    @media (min-width: 1024px) {
        .stats-grid {
            grid-template-columns:repeat(4, 1fr);
        }
    }

    .stat-item {
        text-align: center;
    }

    .stat-val {
        display: block;
        font-size: 2.25rem;
        font-weight: 800;
        color: #fff;
        line-height: 1;
    }

    .stat-lbl {
        display: block;
        font-size: 0.8125rem;
        color: rgba(255, 255, 255, 0.7);
        margin-top: 0.375rem;
    }

    .section-label {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-primary);
        margin-bottom: 0.75rem;
    }

    .section-h2 {
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        margin: 0;
    }

    .values-grid {
        display: grid;
        grid-template-columns:1fr;
        gap: 1.25rem;
    }

    @media (min-width: 640px) {
        .values-grid {
            grid-template-columns:repeat(2, 1fr);
        }
    }

    @media (min-width: 1024px) {
        .values-grid {
            grid-template-columns:repeat(4, 1fr);
        }
    }

    .value-card {
        padding: 1.75rem;
        text-align: center;
    }

    .value-icon {
        width: 56px;
        height: 56px;
        border-radius: var(--radius-lg);
        background: var(--color-primary-50);
        color: var(--color-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        font-size: 1.875rem;
    }

    .value-card h3 {
        font-size: 1.0625rem;
        margin: 0 0 0.625rem;
    }

    .value-card p {
        font-size: 0.875rem;
        color: var(--color-text-muted);
        line-height: 1.65;
        margin: 0;
    }

    /* Timeline */
    .timeline {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        max-width: 700px;
        margin-inline: auto;
    }

    .timeline-item {
        width: 100%;
    }

    .timeline-card {
        padding: 1.25rem 1.5rem;
        border-left: 4px solid var(--color-primary);
    }

    .timeline-year {
        font-size: 1.125rem;
        font-weight: 800;
        color: var(--color-primary);
        display: block;
        margin-bottom: 0.375rem;
    }

    .timeline-event {
        font-size: 0.9375rem;
        color: var(--color-text-muted);
        margin: 0;
        line-height: 1.6;
    }
</style>
