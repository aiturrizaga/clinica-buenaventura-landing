---
import PageLayout from '../../layouts/PageLayout.astro';
import { getLegalPages } from '@features/legal/data';
import { sanitizeHtml, LEGAL_CONTENT_OPTIONS } from '@lib/html/sanitize';

export async function getStaticPaths() {
  const pages = await getLegalPages();
  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
---

<PageLayout
        title={page.title}
        description={`${page.title} de Clínica Buenaventura.`}
>
    <div class="bg-linear-to-br from-primary-50 to-white py-14">
        <div class="container">
            <nav class="flex items-center gap-2 text-sm text-gray-400 mb-4" aria-label="Breadcrumb">
                <a href="/" class="text-primary hover:underline">Inicio</a>
                <span>/</span>
                <span>Legal</span>
                <span>/</span>
                <span aria-current="page">{page.title}</span>
            </nav>
            <h1 class="text-4xl font-extrabold text-gray-900 mb-2">{page.title}</h1>
        </div>
    </div>

    <section class="py-14 bg-white">
        <div class="container max-w-4xl">
            <div class="prose prose-lg max-w-none text-gray-600" set:html={sanitizeHtml(page.content, LEGAL_CONTENT_OPTIONS)} />
        </div>
    </section>
</PageLayout>
