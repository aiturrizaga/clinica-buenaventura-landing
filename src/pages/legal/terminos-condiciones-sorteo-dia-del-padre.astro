---
import PageLayout from '../../layouts/PageLayout.astro';
import { getLegalPageBySlug } from '@features/legal/data';
import { sanitizeHtml, LEGAL_CONTENT_OPTIONS } from '@lib/html/sanitize';

const legalPage = await getLegalPageBySlug('terminos-condiciones-sorteo-dia-del-padre');
if (!legalPage) return Astro.redirect('/404');
---

<PageLayout
        title="Términos y Condiciones – Sorteo Día del Padre"
        description="Términos y Condiciones del Sorteo Día del Padre – Edición Mundialista de Clínica Buenaventura."
>
    <div class="bg-linear-to-br from-primary-50 to-white py-14">
        <div class="container">
            <nav class="flex items-center gap-2 text-sm text-gray-400 mb-4" aria-label="Breadcrumb">
                <a href="/" class="text-primary hover:underline">Inicio</a>
                <span>/</span>
                <span>Legal</span>
                <span>/</span>
                <a href="/legal/terminos-promociones" class="text-primary hover:underline">Términos de Promociones</a>
                <span>/</span>
                <span aria-current="page">Sorteo Día del Padre</span>
            </nav>
            <h1 class="text-4xl font-extrabold text-gray-900 mb-2">{legalPage.title}</h1>
            <p class="text-gray-500 mt-2">
                Clínica Buenaventura sorteará 2 televisores de 45 pulgadas entre sus pacientes.
            </p>
        </div>
    </div>

    <section class="py-14 bg-white">
        <div class="container max-w-4xl">
            <div class="prose prose-lg max-w-none text-gray-600" set:html={sanitizeHtml(legalPage.content, LEGAL_CONTENT_OPTIONS)} />
        </div>
    </section>
</PageLayout>
