---
import PageLayout from '../layouts/PageLayout.astro';
---
<PageLayout
  title="Contacto | Clínica Buenaventura"
  description="Contáctanos para cualquier consulta, cita o información. Estamos en Lima con atención de lunes a domingos."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contacto Clínica Buenaventura',
    description: 'Página de contacto de Clínica Buenaventura',
  }}
>
  <div class="page-banner">
    <div class="container">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/">Inicio</a><span>/</span><span aria-current="page">Contacto</span>
      </nav>
      <h1>Contáctanos</h1>
      <p>Estamos aquí para ayudarte. Escríbenos o llámanos.</p>
    </div>
  </div>

  <section class="section-py" style="background:#fff">
    <div class="container">
      <div class="contact-layout">

        <!-- Form -->
        <div class="contact-form-wrap reveal">
          <h2 class="form-title">Envíanos un mensaje</h2>
          <form id="contact-form" class="contact-form" novalidate>
            <div class="form-row">
              <div class="field">
                <label for="c-name" class="field-label">Nombre completo *</label>
                <input id="c-name" name="name" type="text" class="form-input" required autocomplete="name" placeholder="Juan Pérez" />
              </div>
              <div class="field">
                <label for="c-email" class="field-label">Correo electrónico *</label>
                <input id="c-email" name="email" type="email" class="form-input" required autocomplete="email" placeholder="juan@email.com" />
              </div>
            </div>
            <div class="field">
              <label for="c-phone" class="field-label">Teléfono</label>
              <input id="c-phone" name="phone" type="tel" class="form-input" autocomplete="tel" placeholder="+51 999 000 000" />
            </div>
            <div class="field">
              <label for="c-subject" class="field-label">Asunto *</label>
              <select id="c-subject" name="subject" class="form-input" required>
                <option value="">Selecciona un asunto</option>
                <option value="cita">Agendar cita</option>
                <option value="info">Información de servicios</option>
                <option value="resultados">Resultados de exámenes</option>
                <option value="facturacion">Facturación y pagos</option>
                <option value="otro">Otro</option>
              </select>
            </div>
            <div class="field">
              <label for="c-message" class="field-label">Mensaje *</label>
              <textarea id="c-message" name="message" class="form-input" rows="5" required placeholder="Escribe tu mensaje aquí..." style="resize:vertical"></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-lg" style="width:100%;justify-content:center">
              Enviar mensaje
              <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
              </svg>
            </button>
            <div id="form-success" class="form-success hidden">
              <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
              ¡Mensaje enviado! Te contactaremos a la brevedad.
            </div>
          </form>
        </div>

        <!-- Info -->
        <aside class="contact-info reveal" style="animation-delay:0.12s">
          <div class="info-card card">
            <h2 class="info-title">Información de contacto</h2>

            <div class="info-items">
              {[
                {
                  icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z',
                  title: 'Dirección',
                  content: 'Calle 123 #45-67, San Isidro, Lima, Perú',
                },
                {
                  icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z',
                  title: 'Teléfono',
                  content: '+51 (1) 234-5678',
                },
                {
                  icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
                  title: 'Email',
                  content: 'info@clinicabuenaventura.com',
                },
              ].map(item => (
                <div class="info-item">
                  <div class="info-icon">
                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d={item.icon}/>
                    </svg>
                  </div>
                  <div>
                    <p class="info-label">{item.title}</p>
                    <p class="info-val">{item.content}</p>
                  </div>
                </div>
              ))}
            </div>

            <div class="hours-block">
              <h3 class="hours-title">Horarios de atención</h3>
              <dl class="hours-list">
                {[
                  ['Lunes – Viernes', '7:00 am – 7:00 pm'],
                  ['Sábados', '7:00 am – 1:00 pm'],
                  ['Domingos y Festivos', 'Solo urgencias'],
                  // ['Urgencias', '24 horas'],
                ].map(([dt, dd]) => (
                  <div>
                    <dt>{dt}</dt>
                    <dd style={dt === 'Urgencias' ? 'color:var(--color-primary);font-weight:700' : ''}>{dd}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>

          <a href="/agendar-cita" class="btn btn-primary btn-lg" style="width:100%;justify-content:center;margin-top:1.25rem">
            Agendar cita online
          </a>
        </aside>
      </div>
    </div>
  </section>

  <!-- Map -->
  <section aria-label="Ubicación en mapa">
    <div class="map-container">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3901.1!2d-77.04!3d-12.09!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTLCsDA1JzI0LjAiUyA3N8KwMDInMjQuMCJX!5e0!3m2!1ses!2spe!4v1000000000000!5m2!1ses!2spe"
        width="100%"
        height="400"
        style="border:0"
        loading="lazy"
        allowfullscreen
        referrerpolicy="no-referrer-when-downgrade"
        title="Ubicación de Clínica Buenaventura en el mapa"
      ></iframe>
    </div>
  </section>
</PageLayout>

<style>
  .page-banner { padding-block:3.5rem;background:linear-gradient(135deg,#EEF3FF,#fff); }
  .breadcrumb { display:flex;align-items:center;gap:0.5rem;font-size:0.875rem;color:var(--color-text-muted);margin-bottom:1.25rem; }
  .breadcrumb a { color:var(--color-primary); }
  .page-banner h1 { font-size:clamp(2rem,4vw,3rem);margin:0 0 0.5rem; }
  .page-banner p  { font-size:1.0625rem;color:var(--color-text-muted);margin:0; }

  .contact-layout {
    display:grid;grid-template-columns:1fr;gap:3rem;align-items:start;
  }
  @media (min-width:1024px) { .contact-layout { grid-template-columns:1fr 380px; } }

  .form-title { font-size:1.5rem;margin:0 0 1.75rem; }
  .contact-form { display:flex;flex-direction:column;gap:1.125rem; }
  .form-row { display:grid;grid-template-columns:1fr;gap:1.125rem; }
  @media (min-width:640px) { .form-row { grid-template-columns:1fr 1fr; } }
  .field { display:flex;flex-direction:column;gap:0.375rem; }
  .field-label { font-size:0.9rem;font-weight:600;color:var(--color-text); }

  .form-success {
    display:flex;align-items:center;gap:0.625rem;
    background:#D1FAE5;color:#065F46;
    border-radius:var(--radius-md);padding:0.875rem 1rem;
    font-weight:600;font-size:0.9375rem;
  }
  .hidden { display:none; }

  .info-card { padding:1.75rem; }
  .info-title { font-size:1.25rem;margin:0 0 1.5rem; }
  .info-items { display:flex;flex-direction:column;gap:1.125rem;margin-bottom:1.5rem;padding-bottom:1.5rem;border-bottom:1px solid #F3F4F6; }
  .info-item { display:flex;align-items:flex-start;gap:0.875rem; }
  .info-icon {
    width:40px;height:40px;border-radius:var(--radius-md);
    background:var(--color-primary-50);color:var(--color-primary);
    display:flex;align-items:center;justify-content:center;flex-shrink:0;
  }
  .info-label { font-size:0.8rem;color:var(--color-text-muted);margin:0 0 0.1rem; }
  .info-val   { font-size:0.9375rem;font-weight:600;color:var(--color-text);margin:0; }

  .hours-title { font-size:1rem;font-weight:700;margin:0 0 0.875rem; }
  .hours-list { display:flex;flex-direction:column;gap:0.5rem; }
  .hours-list div { display:flex;justify-content:space-between;font-size:0.875rem; }
  .hours-list dt { color:var(--color-text-muted); }
  .hours-list dd { font-weight:600;color:var(--color-text);margin:0; }

  .map-container { height:400px; }
  .map-container iframe { display:block; }
</style>

<script>
  document.getElementById('contact-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const successEl = document.getElementById('form-success');
    if (successEl) {
      successEl.classList.remove('hidden');
      (e.target as HTMLFormElement).reset();
    }
  });
</script>
