---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { blogPosts, getPostBySlug } from '@features/blog/data';
import { renderMarkdown } from '@features/blog/markdown';
import { ROUTES } from '@config/routes';

export async function getStaticPaths() {
  return blogPosts.map(p => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = getPostBySlug(slug!);
if (!post) return Astro.redirect('/404');

function formatDate(d: string) {
  return new Date(d).toLocaleDateString('es-PE', { day:'numeric', month:'long', year:'numeric' });
}
---
<BlogLayout post={post}>
  <div class="container" style="padding-block:3rem">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <a href="/">Inicio</a><span>/</span>
      <a href="/blog">Blog</a><span>/</span>
      <span aria-current="page">{post.title}</span>
    </nav>

    <div class="blog-layout" style="margin-top:2rem">
      <article>
        <!-- Cover -->
        <div class="cover-img">
          <img src={post.coverImage} alt={post.title} width="800" height="450" loading="eager" />
          <span class="cat-badge">{post.category}</span>
        </div>

        <!-- Meta -->
        <div class="post-meta">
          <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
          <span>·</span>
          <span>{post.readingTime} min de lectura</span>
        </div>

        <h1 class="post-title">{post.title}</h1>
        <p class="post-excerpt">{post.excerpt}</p>

        <!-- Author -->
        <div class="author-row">
          <img src={post.author.avatar} alt={post.author.name} width="48" height="48" />
          <div>
            <p class="author-name">{post.author.name}</p>
            <p class="author-role">{post.author.role}</p>
          </div>
        </div>

        <!-- Content -->
        <div class="prose post-content" set:html={renderMarkdown(post.content)} />

        <!-- Tags -->
        <div class="tags">
          {post.tags.map(tag => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="blog-sidebar">
        <div class="sidebar-card">
          <h3 class="sidebar-title">¿Necesitas atención?</h3>
          <p style="font-size:0.875rem;color:var(--color-text-muted);margin:0 0 1rem">Agenda tu cita con nuestros especialistas.</p>
          <a href={ROUTES.citas.index} class="btn btn-primary btn-md" style="width:100%;justify-content:center">Agendar cita</a>
        </div>
        <div class="sidebar-card">
          <h3 class="sidebar-title">Especialidades</h3>
          <ul class="sidebar-links">
            {['Cardiología','Pediatría','Ginecología','Traumatología','Dermatología'].map(s=>(
              <li><a href={`/especialidades/${s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'')}`}>{s}</a></li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</BlogLayout>

<style>
  .breadcrumb { display:flex;align-items:center;gap:0.5rem;font-size:0.875rem;color:var(--color-text-muted); }
  .breadcrumb a { color:var(--color-primary); }

  .blog-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }
  @media (min-width: 1024px) { .blog-layout { grid-template-columns: 1fr 300px; } }

  .cover-img {
    position:relative;border-radius:var(--radius-2xl);overflow:hidden;
    aspect-ratio:16/9;margin-bottom:1.5rem;
    box-shadow:var(--shadow-card);
  }
  .cover-img img { width:100%;height:100%;object-fit:cover; }
  .cat-badge {
    position:absolute;top:1rem;left:1rem;
    background:var(--color-primary);color:#fff;
    font-size:0.7rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;
    padding:0.25rem 0.75rem;border-radius:var(--radius-full);
  }

  .post-meta {
    display:flex;align-items:center;gap:0.5rem;
    font-size:0.875rem;color:var(--color-text-muted);margin-bottom:0.875rem;
  }
  .post-title { font-size:clamp(1.625rem,3vw,2.5rem);line-height:1.2;margin:0 0 1rem; }
  .post-excerpt { font-size:1.0625rem;color:var(--color-text-muted);line-height:1.7;margin:0 0 1.5rem;font-weight:500; }

  .author-row {
    display:flex;align-items:center;gap:0.875rem;
    padding-block:1.25rem;
    border-block:1px solid #F3F4F6;
    margin-bottom:2rem;
  }
  .author-row img { border-radius:50%;object-fit:cover; }
  .author-name { font-weight:700;font-size:0.9375rem;color:var(--color-text);margin:0; }
  .author-role { font-size:0.8125rem;color:var(--color-text-muted);margin:0; }

  .post-content { margin-top:1rem; }

  .tags { display:flex;flex-wrap:wrap;gap:0.5rem;margin-top:2rem;padding-top:1.5rem;border-top:1px solid #F3F4F6; }
  .tag {
    font-size:0.8125rem;color:var(--color-primary);
    background:var(--color-primary-50);
    padding:0.25rem 0.75rem;border-radius:var(--radius-full);font-weight:600;
  }

  .sidebar-card {
    background:#fff;border-radius:var(--radius-xl);padding:1.375rem;
    box-shadow:var(--shadow-card);margin-bottom:1.25rem;
  }
  .sidebar-title { font-size:1rem;font-weight:700;color:var(--color-text);margin:0 0 0.875rem; }
  .sidebar-links { list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.5rem; }
  .sidebar-links a {
    font-size:0.9rem;color:var(--color-text-muted);
    display:flex;align-items:center;gap:0.375rem;
    transition:color 0.2s;
  }
  .sidebar-links a::before { content:'→';color:var(--color-primary); }
  .sidebar-links a:hover { color:var(--color-primary); }
</style>
