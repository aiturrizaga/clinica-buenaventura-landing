---
// Button.astro
interface Props {
  variant?: 'primary' | 'outline' | 'ghost' | 'white' | 'outline-white';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  id?: string;
  class?: string;
  ariaLabel?: string;
  disabled?: boolean;
  fullWidth?: boolean;
  target?: string;
  // Allows JS hooks like data-action on consumers without widening Props to `any`.
  [key: `data-${string}`]: string | boolean | undefined;
}
const {
  variant = 'primary',
  size    = 'md',
  href,
  type    = 'button',
  id,
  class: cls,
  ariaLabel,
  disabled = false,
  fullWidth = false,
  target,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const classes = [
  'btn',
  `btn-${variant}`,
  `btn-${size}`,
  fullWidth && 'btn-full',
  cls,
].filter(Boolean).join(' ');
---
<Tag
  id={id}
  href={href}
  type={!href ? type : undefined}
  class={classes}
  aria-label={ariaLabel}
  disabled={!href ? disabled : undefined}
  target={target}
  rel={target === '_blank' ? 'noopener noreferrer' : undefined}
  {...rest}
>
  <slot />
</Tag>
<style>
  .btn-full { width: 100%; justify-content: center; }
</style>
