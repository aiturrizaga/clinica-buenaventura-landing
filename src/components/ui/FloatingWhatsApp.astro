---
interface Props {
    phone: string;
    message?: string;
}
const {
    phone,
    message = 'Hola Clínica Buenaventura, vengo de la página web y requiero una consulta médica.'
} = Astro.props;
const cleanPhone = phone.replace(/\D/g, '');
const waUrl = `https://wa.me/${ cleanPhone }?text=${ encodeURIComponent(message) }`;
---
<a
        href={ waUrl }
        target="_blank"
        rel="noopener noreferrer"
        class="wa-float"
        aria-label="Contactar por WhatsApp"
>
    <div class="wa-avatar">
        <img
                src="/icon-whatsapp.svg"
                alt="Asesor Clínica Buenaventura"
                width="80"
                height="80"
        />
    </div>

    <div class="wa-contact">
        <img
                src="/images/logo-whatsapp.svg"
                alt=""
                aria-hidden="true"
                width="22"
                height="22"
        />

        <span>CONTÁCTANOS</span>
    </div>
</a>

<style>
    .wa-float {
        position: fixed;
        right: 1.75rem;
        bottom: 1.75rem;
        z-index: 200;

        display: flex;
        flex-direction: column;
        align-items: center;

        text-decoration: none;

        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .wa-float:hover {
        transform: scale(1.05);
    }

    .wa-avatar {
        width: 75px;
        height: 75px;
        border-radius: 50%;
        overflow: hidden;

        background: #b9d8e8;
        border: 3px solid rgba(255, 255, 255, 0.7);

        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18);
    }

    .wa-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .wa-contact {
        position: relative;

        margin-top: -4px;

        display: flex;
        align-items: center;
        gap: 0.35rem;

        background: var(--color-primary);
        color: white;

        border-radius: 8px;

        font-size: 0.7rem;
        padding: 0.35rem 0.7rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        line-height: 1;

        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
    }

    .wa-contact img {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
    }

    .wa-contact::before {
        content: "";
        position: absolute;
        top: -8px;
        left: 50%;
        transform: translateX(-50%);

        width: 0;
        height: 0;

        border-left: 8px solid transparent;
        border-right: 8px solid transparent;
        border-bottom: 8px solid var(--color-primary);
    }
</style>
