---
interface Props {
    id: string;
    name?: string;
    ariaLabel?: string;
    required?: boolean;
    disabled?: boolean;
    inputClass?: string;
    class?: string;
}

const {
    id,
    name,
    ariaLabel,
    required = false,
    disabled = false,
    inputClass = 'form-input appearance-none pr-10',
    class: cls = '',
} = Astro.props;
---
<div class:list={ ['relative', cls] }>
    <select
            id={ id }
            name={ name }
            aria-label={ ariaLabel }
            required={ required }
            disabled={ disabled }
            class={ inputClass }
    >
        <slot/>
    </select>
    <i
            class="ti ti-chevron-down pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-primary"
            aria-hidden="true"
    ></i>
</div>
