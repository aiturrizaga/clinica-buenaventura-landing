---
interface Props {
  variant?: 'primary' | 'white' | 'green' | 'purple';
  class?: string;
}
const { variant = 'primary', class: cls } = Astro.props;
---
<span class:list={['badge', `badge-${variant}`, cls]}>
  <slot />
</span>
<style>
  .badge-purple { background: #EDE9FE; color: #5B21B6; }
</style>
