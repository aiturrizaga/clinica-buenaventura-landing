---
import Overlay from './Overlay.astro';

interface Props {
    id: string;
    labelledby?: string;
}

const { id, labelledby = `${ Astro.props.id }-title` } = Astro.props;
---
<Overlay id={ id } labelledby={ labelledby } class="items-end justify-center sm:items-center sm:p-4">
    <div
            class="confirm-panel w-full max-w-full translate-y-full rounded-t-[22px] bg-white px-6 pb-8 pt-3 text-center shadow-[0_10px_40px_rgba(13,53,120,0.25)] transition-transform duration-300 ease-out group-[&:not(.hidden)]:translate-y-0 sm:max-w-md sm:translate-y-0 sm:rounded-[20px] sm:p-8 sm:pt-8"
            data-confirm-panel
    >
        <!-- Drag handle (mobile only) -->
        <div
                class="mx-auto mb-4 h-1.5 w-12 cursor-grab rounded-full bg-primary-100 sm:hidden"
                data-confirm-handle
                aria-hidden="true"
        ></div>

        <slot name="icon"/>
        <slot name="title"/>
        <slot name="body"/>

        <div class="mt-7 flex flex-col-reverse gap-3 sm:flex-row sm:justify-center *:flex-1">
            <slot name="actions"/>
        </div>
    </div>
</Overlay>

<script>
    // Drag-to-dismiss (mobile bottom sheet). Backdrop click, Escape and focus
    // trap are handled centrally by Overlay.astro.
    function bindConfirmPanel(panel: HTMLElement) {
        if (panel.dataset.dragBound) return;
        panel.dataset.dragBound = 'true';

        const overlay = panel.closest<HTMLElement>('[data-overlay]');
        const handle = panel.querySelector<HTMLElement>('[data-confirm-handle]');
        if (!overlay || !handle) return;

        let startY = 0;
        let currentY = 0;
        let dragging = false;

        const onStart = (clientY: number) => {
            dragging = true;
            startY = clientY;
            panel.style.transition = 'none';
        };

        const onMove = (clientY: number) => {
            if (!dragging) return;
            currentY = Math.max(0, clientY - startY);
            panel.style.transform = `translateY(${ currentY }px)`;
        };

        const onEnd = () => {
            if (!dragging) return;
            dragging = false;
            panel.style.transition = '';
            panel.style.transform = '';
            // Dismiss if dragged down more than 120px
            if (currentY > 120) overlay.classList.add('hidden');
            currentY = 0;
        };

        handle.addEventListener('touchstart', (e) => onStart(e.touches[0].clientY), { passive: true });
        handle.addEventListener('touchmove', (e) => onMove(e.touches[0].clientY), { passive: true });
        handle.addEventListener('touchend', onEnd);

        handle.addEventListener('mousedown', (e) => onStart(e.clientY));
        document.addEventListener('mousemove', (e) => onMove(e.clientY));
        document.addEventListener('mouseup', onEnd);
    }

    function initConfirmPanels() {
        document.querySelectorAll<HTMLElement>('[data-confirm-panel]').forEach(bindConfirmPanel);
    }

    document.addEventListener('astro:page-load', initConfirmPanels);
</script>
