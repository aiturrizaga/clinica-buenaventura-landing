---
import { getSite } from '@config/site';

const GA_ID = (await getSite()).gaId;
---

{ GA_ID && (
<script is:inline async src={ `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
<script is:inline define:vars={{ GA_ID }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(...args){dataLayer.push(args);}
    gtag('js', new Date());

    gtag('config', GA_ID);
</script>
) }
