---
const year = new Date().getFullYear();
---

<footer class="bg-[#0D1526] text-white/65 pt-16 pb-10 mt-auto">
    <div class="container">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1.4fr] gap-10 mb-12">

            <!-- Brand -->
            <div>
                <a href="/" aria-label="Clínica Buenaventura" class="flex items-center gap-3 no-underline mb-4">
                    <img src="/logo_footer_web.svg" alt="Logo Clínica Buenaventura" class="h-14 w-auto"/>
                </a>
                <p class="text-sm text-white/50 leading-relaxed max-w-65 mb-5">
                    Cuidamos tu salud, cuidamos tu vida. Excelencia médica con calidez humana.
                </p>
                <div class="flex gap-2.5" aria-label="Redes sociales">
                    { [
                        {
                            href: 'https://www.facebook.com/clinicabuenaventurasjm',
                            label: 'Facebook',
                            path: 'M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z'
                        },
                        {
                            href: 'https://www.instagram.com/clinicabuenaventura',
                            label: 'Instagram',
                            path: 'M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37zM17.5 6.5h.01M6.5 6.5h.01M2 6.5C2 4 4 2 6.5 2h11C20 2 22 4 22 6.5v11C22 20 20 22 17.5 22h-11C4 22 2 20 2 17.5z'
                        },
                        {
                            href: 'https://www.tiktok.com/@clinicabuenaventura',
                            label: 'Tiktok',
                            path: 'M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.76a4.85 4.85 0 01-1.01-.07z'
                        },
                        {
                            href: 'https://www.youtube.com/@clinicabuenaventura',
                            label: 'YouTube',
                            path: 'M22.54 6.42a2.78 2.78 0 00-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 00-1.95 1.96A29 29 0 001 12a29 29 0 00.46 5.58A2.78 2.78 0 003.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 001.95-1.95A29 29 0 0023 12a29 29 0 00-.46-5.58zM9.75 15.02V8.98L15.5 12l-5.75 3.02z'
                        },
                        {
                            href: 'https://www.linkedin.com/company/clinicabuenaventura',
                            label: 'Linkedin',
                            path: 'M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z M4 6a2 2 0 100-4 2 2 0 000 4z'
                        },
                    ].map(s => (
                            <a
                                    href={ s.href }
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    aria-label={ s.label }
                                    class="w-9 h-9 rounded-full border border-white/15 flex items-center justify-center text-white/50 hover:bg-primary hover:border-primary hover:text-white transition-colors duration-200"
                            >
                                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                                     stroke-width="1.5" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d={ s.path }/>
                                </svg>
                            </a>
                    )) }
                </div>
            </div>

            <!-- Enlaces rápidos -->
            <div>
                <h3 class="text-sm font-bold text-gray-300! uppercase tracking-wide mb-4">Enlaces rápidos</h3>
                <ul class="flex flex-col gap-2 list-none p-0 m-0">
                    { [
                        ['Inicio', '/'],
                        ['Nosotros', '#nosotros'],
                        ['Especialidades', '#especialidades'],
                        // ['Servicios', '/servicios'],

                        ['Médicos', '#medicos'],
                        // ['Urgencias', '/contacto'],
                        // ['Club Buenaventura', '/club-buenaventura'],

                    ].map(([label, href]) => (
                            <li>
                                <a href={ href }
                                   class="text-sm text-white/55 hover:text-white transition-colors duration-200 no-underline">
                                    { label }
                                </a>
                            </li>
                    )) }
                </ul>
            </div>

            <!-- Servicios -->
            <div>
                <h3 class="text-sm font-bold text-gray-300! uppercase tracking-wide mb-4">Legales</h3>
                <ul class="flex flex-col gap-2 list-none p-0 m-0">
                    { [
                        ['Términos y Condiciones (T&C)', '/legal/terminos-condiciones'],
                        ['Política de Privacidad', '/legal/politica-privacidad'],
                        ['T&C Promociones', '/legal/terminos-promociones'],
                        ['T&C Sorteo Día del Padre', '/legal/terminos-condiciones-sorteo-dia-del-padre'],
                    ].map(([label, href]) => (
                            <li>
                                <a href={ href }
                                   class="text-sm text-white/55 hover:text-white transition-colors duration-200 no-underline">
                                    { label }
                                </a>
                            </li>
                    )) }
                </ul>
            </div>

            <!-- Contacto -->
            <div>
                <h3 class="text-sm font-bold text-gray-300! uppercase tracking-wide mb-4">Contacto</h3>
                <address class="not-italic flex flex-col gap-3 mb-5">
                    { [
                        {
                            icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z',
                            text: 'Dirección: Av. San Juan N.° 871, San Juan de Miraflores',
                            href: 'https://www.google.com/maps/place/Cl%C3%ADnica+Buenaventura/@-12.158772,-76.973447,13z/data=!4m6!3m5!1s0x9105b9db90b20dd5:0xfab3be931acb300!8m2!3d-12.1587718!4d-76.9734474!16s%2Fg%2F11j7jkq6pp?hl=es&entry=ttu&g_ep=EgoyMDI2MDUyNy4wIKXMDSoASAFQAw%3D%3D',
                        },
                        {
                            icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z',
                            text: '932 939 530',
                            href: 'https://wa.me/51932939530'
                        },
                        {
                            icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
                            text: 'atencionalcliente@clinicabuenaventura.com',
                            href: 'mailto:atencionalcliente@clinicabuenaventura.com'
                        },
                    ].map(item => (
                            <div class="flex items-start gap-2.5 text-sm text-white/55">
                                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                                     stroke-width="2" aria-hidden="true" class="shrink-0 mt-0.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d={ item.icon }/>
                                </svg>
                                {
                                    item.href &&
                                        <a href={item.href} target="_blank" class="hover:text-gray-300!">{ item.text }</a>
                                }
                                {
                                    !item.href && <span>{ item.text }</span>
                                }
                            </div>
                    )) }
                </address>

                <h4 class="text-xs font-bold text-gray-300! uppercase tracking-wide mb-2">Horarios de atención</h4>
                <dl class="flex flex-col gap-1.5">
                    { [
                        ['Lun – Dom', '7:00 am – 8:00 pm', false],
                        // ['Sábados', '7:00 am – 1:00 pm', false],
                        // ['Urgencias', '24 horas', true],

                    ].map(([dt, dd, highlight]) => (
                            <div class="flex justify-between text-[0.8125rem]">
                                <dt class="text-white/50">{ dt }</dt>
                                <dd class:list={ ['m-0 font-medium', highlight ? 'text-primary' : 'text-white/85'] }>{ dd }</dd>
                            </div>
                    )) }
                </dl>
            </div>
        </div>

        <!-- Bottom -->
        <div class="pt-6 border-t border-white/8 flex flex-col sm:flex-row items-center justify-between gap-3 text-[0.8125rem] text-white/35">
            <p class="m-0">© { year } Clínica Buenaventura. Todos los derechos reservados.</p>
            <!--<div class="flex gap-6">-->
            <!--    <a href="/politica-privacidad"-->
            <!--       class="text-white/35 hover:text-white/70 transition-colors duration-200 no-underline">Política de-->
            <!--        privacidad</a>-->
            <!--    <a href="/terminos"-->
            <!--       class="text-white/35 hover:text-white/70 transition-colors duration-200 no-underline">Términos de-->
            <!--        uso</a>-->
            <!--</div>-->
        </div>
    </div>
</footer>
