---
import { navItems } from '@config/navigation';
import { whatsappLink, WHATSAPP_MESSAGES } from '@config/social';
const currentPath = Astro.url.pathname;
const waLink = whatsappLink(WHATSAPP_MESSAGES.general);
---

<header id="site-header"
        class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-b border-black/6 transition-shadow duration-300">
    <div class="container">
        <div class="flex items-center justify-between h-18 gap-4">

            <!-- Logo -->
            <a href="/" aria-label="Clínica Buenaventura — Inicio" class="shrink-0">
                <img src="/logo_header_web.svg" alt="Logo Clínica Buenaventura" class="h-6 sm:h-8 md:h-10 w-auto"/>
            </a>

            <!-- Nav desktop -->
            <nav aria-label="Navegación principal" class="hidden lg:flex items-center gap-1">
                { navItems.map(item => (
                        <a
                                href={ item.href }
                                class:list={ [
                                    'px-3 py-2 rounded-lg text-sm font-medium transition-colors duration-150',
                                    currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
                                        ? 'text-primary bg-primary/8'
                                        : 'text-gray-500 hover:text-gray-900 hover:bg-gray-50'
                                ] }
                                aria-current={ currentPath === item.href ? 'page' : undefined }
                        >
                            { item.label }
                        </a>
                )) }
            </nav>

            <!-- CTA + burger -->
            <div class="flex items-center gap-3">
                <a href={ waLink }
                   target="_blank" rel="noopener noreferrer"
                   class="btn btn-primary btn-sm hidden sm:inline-flex"
                   aria-label="Agendar cita médica">
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
                         aria-hidden="true">
                        <rect x="3" y="4" width="18" height="18" rx="2"/>
                        <path d="M16 2v4M8 2v4M3 10h18"/>
                    </svg>
                    Agendar cita
                </a>

                <button
                        id="burger-btn"
                        class="lg:hidden flex flex-col gap-1.25 p-2 bg-transparent border-none cursor-pointer rounded-lg"
                        aria-label="Abrir menú"
                        aria-expanded="false"
                        aria-controls="mobile-menu"
                >
                    <span class="burger-line"></span>
                    <span class="burger-line"></span>
                    <span class="burger-line"></span>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile menu -->
    <div
            id="mobile-menu"
            class="mobile-menu hidden lg:hidden border-t border-black/6 bg-white pb-6"
            aria-hidden="true"
    >
        <nav aria-label="Menú móvil" class="px-2 pt-2">
            { navItems.map(item => (
                    <a
                            href={ item.href }
                            class:list={ [
                                'block px-4 py-3 rounded-lg text-base font-medium mx-1 transition-colors duration-150',
                                currentPath === item.href
                                    ? 'text-primary bg-primary/8'
                                    : 'text-gray-500 hover:text-primary hover:bg-primary/8'
                            ] }
                    >
                        { item.label }
                    </a>
            )) }
            <div class="px-1 mt-3">
                <a href={ waLink }
                   class="btn btn-primary btn-md w-full justify-center">
                    Agendar cita
                </a>
            </div>
        </nav>
    </div>
</header>

<!-- Spacer para compensar el fixed -->
<div class="h-18"></div>

<style>
    .burger-line {
        display: block;
        width: 22px;
        height: 2px;
        background: var(--color-text);
        border-radius: 2px;
        transition: all 0.3s;
    }

    #burger-btn.open .burger-line:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
    }

    #burger-btn.open .burger-line:nth-child(2) {
        opacity: 0;
    }

    #burger-btn.open .burger-line:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
    }

    #site-header.scrolled {
        box-shadow: 0 2px 20px rgba(0, 39, 223, 0.1);
    }
</style>

<script>
    function initHeader() {
        const burger = document.getElementById('burger-btn');
        const menu = document.getElementById('mobile-menu');
        const header = document.getElementById('site-header');
        if (!burger || !menu || !header) return;

        burger.addEventListener('click', () => {
            const isOpen = menu.classList.toggle('hidden') === false;
            burger.classList.toggle('open', isOpen);
            burger.setAttribute('aria-expanded', String(isOpen));
            menu.setAttribute('aria-hidden', String(!isOpen));
        });

        const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 10);
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
    }

    // astro:page-load ya dispara en la carga inicial (no solo tras transiciones),
    // así que basta con este listener — llamarlo también de forma directa duplicaría
    // los listeners del burger en cada navegación.
    document.addEventListener('astro:page-load', initHeader);
</script>
