---
import { branches } from '@/data/branches';
import { specialties } from '@/data/specialties';

interface Props {
    branch?: string;
    specialty?: string;
}

const { branch = '', specialty = '' } = Astro.props;

const sortedSpecialties = [...specialties].sort((a, b) => a.name.localeCompare(b.name));
---

<header class="bg-primary text-white">
    <div class="container flex flex-wrap items-end gap-5 py-5">
        <h1 class="self-center shrink-0 text-2xl md:text-3xl font-bold text-white!">
            Reserva de tu cita
        </h1>

        <div class="flex-1 min-w-50">
            <label class="block mb-1.5 text-sm/none opacity-95" for="header-branch">Sede</label>
            <div class="relative">
                <select
                        id="header-branch"
                        class="w-full appearance-none rounded-md border-0 bg-white px-4 py-3 pr-10 text-text outline-none"
                >
                    { branches.map((b) => (
                            <option value={ b.slug } selected={ b.slug === branch }>{ b.name }</option>
                    )) }
                </select>
                <i class="ti ti-chevron-down pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-primary"></i>
            </div>
        </div>

        <div class="flex-1 min-w-50">
            <label class="block mb-1.5 text-sm/none opacity-95" for="header-specialty">Especialidad</label>
            <div class="relative">
                <select
                        id="header-specialty"
                        class="w-full appearance-none rounded-md border-0 bg-white px-4 py-3 pr-10 text-text outline-none"
                >
                    <option value="">Todas las especialidades</option>
                    { sortedSpecialties.map((s) => (
                            <option value={ s.slug } selected={ s.slug === specialty }>{ s.name }</option>
                    )) }
                </select>
                <i class="ti ti-chevron-down pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-primary"></i>
            </div>
        </div>

        <button
                type="button"
                class="self-end cursor-pointer rounded-full border-2 border-white bg-transparent px-7 py-3 font-bold text-white transition-colors hover:bg-white hover:text-primary"
        >
            Buscar cita
        </button>
    </div>
</header>

<div class="bg-primary-50">
    <div class="container flex flex-wrap gap-4 py-4">
        <div class="relative basis-65 grow-0">
            <input
                    id="header-date"
                    type="text"
                    readonly
                    placeholder="Buscar por fecha"
                    aria-label="Fecha de la cita"
                    class="w-full rounded-md border-[1.5px] border-primary-100 bg-white px-4 py-2.5 pr-10 text-[0.95rem] outline-none focus:border-primary"
            />
            <i class="ti ti-calendar absolute right-3 top-1/2 -translate-y-1/2 text-primary"></i>
        </div>

        <div class="relative min-w-65 flex-1">
            <input
                    id="header-doctor"
                    type="text"
                    placeholder="Buscar por nombre de doctor"
                    aria-label="Nombre del doctor"
                    class="w-full rounded-md border-[1.5px] border-primary-100 bg-white px-4 py-2.5 pr-10 text-[0.95rem] outline-none focus:border-primary"
            />
            <i class="ti ti-search absolute right-3 top-1/2 -translate-y-1/2 text-primary"></i>
        </div>
    </div>
</div>
