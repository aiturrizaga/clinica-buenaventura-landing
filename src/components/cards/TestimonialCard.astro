---
import type { Testimonial } from '../../types';

interface Props {
  testimonial: Testimonial;
}
const { testimonial: t } = Astro.props;
---
<article class="testimonial-card card" aria-label={`Testimonio de ${t.name}`}>
  <div class="quote-icon" aria-hidden="true">
    <svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
    </svg>
  </div>

  <div class="stars" aria-label={`Calificación: ${t.rating} de 5`}>
    {Array.from({ length: 5 }).map((_, i) => (
      <svg width="14" height="14" viewBox="0 0 24 24" fill={i < t.rating ? '#FBBF24' : '#E5E7EB'} aria-hidden="true">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
      </svg>
    ))}
  </div>

  <p class="comment">"{t.comment}"</p>

  <div class="author">
    <img src={t.avatar} alt={t.name} width="44" height="44" loading="lazy" />
    <div>
      <p class="author-name">{t.name}</p>
      <p class="author-meta">{t.role}{t.specialty ? ` · ${t.specialty}` : ''}</p>
    </div>
  </div>
</article>

<style>
  .testimonial-card { padding: 1.5rem; display: flex; flex-direction: column; gap: 0.875rem; }

  .quote-icon { color: var(--color-primary); opacity: 0.25; }

  .stars { display: flex; gap: 2px; }

  .comment {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
    flex: 1;
    font-style: italic;
  }

  .author {
    display: flex; align-items: center; gap: 0.75rem;
    padding-top: 0.875rem;
    border-top: 1px solid #F3F4F6;
  }
  .author img { border-radius: 50%; object-fit: cover; flex-shrink: 0; }
  .author-name { font-weight: 700; font-size: 0.9375rem; color: var(--color-text); margin: 0; }
  .author-meta { font-size: 0.8125rem; color: var(--color-text-muted); margin: 0; }
</style>
