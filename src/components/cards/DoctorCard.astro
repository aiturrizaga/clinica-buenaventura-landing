---
import type { Doctor } from '@/types';

interface Props {
  doctor: Doctor;
  compact?: boolean;
}
const { doctor, compact = false } = Astro.props;
---
<article class:list={['doctor-card card', compact && 'compact']} aria-label={`${doctor.title} ${doctor.name}, ${doctor.specialty}`}>
  <a href={`/medicos/${doctor.slug}`} class="doctor-card-link">
    <div class="doctor-photo">
      <img
        src={doctor.photo}
        alt={`Foto de ${doctor.title} ${doctor.name}`}
        loading="lazy"
        decoding="async"
        width="300"
        height="380"
      />
    </div>
    <div class="doctor-info">
      <p class="doctor-specialty">{doctor.specialty}</p>
      <h3 class="doctor-name">{doctor.title} {doctor.name}</h3>
      <p class="doctor-cmp">CMP {doctor.cmp}</p>

      <!--{!compact && (-->
      <!--  <div class="doctor-rating" aria-label={`Calificación: ${doctor.rating} de 5`}>-->
      <!--    <div class="stars" aria-hidden="true">-->
      <!--      {Array.from({ length: 5 }).map((_, i) => (-->
      <!--        <svg width="13" height="13" viewBox="0 0 24 24" fill={i < Math.floor(doctor.rating) ? '#FBBF24' : 'none'} stroke="#FBBF24" stroke-width="2">-->
      <!--          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>-->
      <!--        </svg>-->
      <!--      ))}-->
      <!--    </div>-->
      <!--    <span class="rating-count">({doctor.reviewCount})</span>-->
      <!--  </div>-->
      <!--)}-->

      <!--<div class="doctor-footer">-->
      <!--  <span class="view-profile">Ver perfil →</span>-->
      <!--  <a-->
      <!--    href={`/agendar-cita?doctor=${doctor.slug}`}-->
      <!--    class="appt-btn"-->
      <!--    aria-label={`Agendar cita con ${doctor.title} ${doctor.name}`}-->
      <!--    onclick="event.stopPropagation()"-->
      <!--  >-->
      <!--    <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">-->
      <!--      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>-->
      <!--    </svg>-->
      <!--  </a>-->
      <!--</div>-->
    </div>
  </a>
</article>

<style>
  .doctor-card { transition: transform 0.3s, box-shadow 0.3s; }
  .doctor-card:hover { transform: translateY(-4px); }
  .doctor-card-link { display: block; text-decoration: none; color: inherit; }

  .doctor-photo {
    aspect-ratio: 3/4;
    overflow: hidden;
    background: var(--color-surface);
  }
  .compact .doctor-photo { aspect-ratio: 4/3; }
  .doctor-photo img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.5s;
  }
  .doctor-card:hover .doctor-photo img { transform: scale(1.04); }

  .doctor-info { padding: 1.125rem 1.25rem 1.25rem; }

  .doctor-specialty {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
    margin: 0 0 0.25rem;
  }
  .doctor-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.2rem;
    line-height: 1.3;
  }
  .doctor-cmp {
    font-size: 0.75rem;
    color: var(--color-text-light);
    margin: 0 0 0.625rem;
  }

  .doctor-rating {
    display: flex; align-items: center; gap: 0.25rem;
    margin-bottom: 0.875rem;
  }
  .stars { display: flex; gap: 1px; }
  .rating-count { font-size: 0.75rem; color: var(--color-text-muted); }

  .doctor-footer {
    display: flex; align-items: center; justify-content: space-between;
  }
  .view-profile {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
  }
  .appt-btn {
    width: 32px; height: 32px;
    background: var(--color-primary-50);
    color: var(--color-primary);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.2s, color 0.2s;
  }
  .appt-btn:hover { background: var(--color-primary); color: #fff; }
</style>
