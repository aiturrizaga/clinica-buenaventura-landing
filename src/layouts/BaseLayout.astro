---
import { ClientRouter } from 'astro:transitions';
import SEOHead from '../components/seo/SEOHead.astro';
import '../styles/global.css';
import type { SEOProps } from '@/types';
import GoogleAnalytics from '@components/seo/GoogleAnalytics.astro';

type Props = SEOProps;

const seoProps = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#15489d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <SEOHead {...seoProps} />
    <ClientRouter />
    { import.meta.env.PROD && <GoogleAnalytics /> }
  </head>
  <body>
    <slot />

    <!-- Scroll reveal: re-observado en cada navegación del Client Router -->
    <script>
      function initScrollReveal() {
        const io = new IntersectionObserver(
          (entries) => entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.classList.add('visible');
              io.unobserve(e.target);
            }
          }),
          { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.reveal').forEach(el => io.observe(el));
      }

      // astro:page-load dispara también en la carga inicial, no solo tras transiciones.
      document.addEventListener('astro:page-load', initScrollReveal);
    </script>
  </body>
</html>
